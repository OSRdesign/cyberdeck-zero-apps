title Home Assistant: a room: its entities (toggles and the scene with a dot, sensors grey); a tap on a name toggles ("...", then Off), a tap on the value opens the entity page; typing filters the room
sizes 480x320 640x480 800x480 1024x600 1280x720 1280x800 720x720 480x800 480x640 800x1280
env HA_DEMO home

wait 900
key end
key up
key up
key enter
wait 600
shot room
check room
expect text "Ceiling light"
expect text "On"
# the first row is highlighted: one tap on its name acts
tap "Ceiling light"
wait 100
shot toggled
wait 700
expect text "Off"
shot toggle-done
check toggle-done
# a tap on the value side (the right 40 % of the row) of the selected row opens the entity page (640x480: the first row)
@640x480 tapxy 0.92 0.27
@640x480 wait 600
@640x480 expect text "Remove from favourites"
@640x480 shot value-side-opens-page
@640x480 key esc
@640x480 wait 400
keyboards 1
wait 300
type "lamp"
wait 300
expect text "FILTER: LAMP"
expect text "Reading lamp"
expect notext "Ceiling light"
shot filtered
check filtered
key backspace
key backspace
key backspace
key backspace
wait 300
expect text "Ceiling light"
type "zz"
wait 300
expect text "Nothing matches"
key esc
wait 300
expect text "Ceiling light"
key esc
wait 300
expect text "FAVOURITES"
expect noquit
