title Home Assistant: the entity page of a dimmable light (Right on its row): state and attributes, the brightness slider (Left / Right by 10 %), the favourite row
sizes 480x320 640x480 800x480 1024x600 1280x720 1280x800 720x720 480x800 480x640 800x1280
env HA_DEMO home

wait 900
key right
wait 600
shot light
check light
expect text "72 %"
expect text "Remove from favourites"
key right
wait 900
expect text "82 %"
shot slider
check slider
key left
key left
key left
wait 900
expect text "52 %"
shot slider-down
check slider-down
# touch: a tap on the highlighted slider row, left of the knob, steps down by 10 %
tap "52 %"
wait 900
expect text "42 %"
key up
key up
key up
wait 400
shot light-top
expect text "State"
key esc
wait 400
expect text "FAVOURITES"
expect noquit
