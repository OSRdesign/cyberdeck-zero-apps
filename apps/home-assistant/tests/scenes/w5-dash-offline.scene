title Home Assistant 0.3.0: a start without a connection: the stored dashboard of the last session (dashboard.json) at once, greyed, the names kept, the tab bar saying Offline (time running 20 times faster)
sizes 480x320 640x480 800x480 1024x600 1280x720 1280x800 720x720 480x800 480x640 800x1280
env HA_DEMO dash-offline
env HA_DEMO_SPEED 20

wait 3500
shot dash-offline
check dash-offline
expect text "Living room"
@640x480,800x480,1024x600,1280x720,1280x800,720x720,480x800,480x640,800x1280 expect text "Lamp"
expect notext "Online"
drag 0.5 0.92 0.5 0.30
wait 300
drag 0.5 0.92 0.5 0.30
wait 300
drag 0.5 0.92 0.5 0.30
wait 300
drag 0.5 0.92 0.5 0.30
wait 300
drag 0.5 0.92 0.5 0.30
wait 300
drag 0.5 0.92 0.5 0.30
wait 300
drag 0.5 0.92 0.5 0.30
wait 300
drag 0.5 0.92 0.5 0.30
wait 500
shot dash-offline-lower
check dash-offline-lower
expect noquit
