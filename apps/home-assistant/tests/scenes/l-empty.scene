title Home Assistant: empty states: no favourite yet, no room in Home Assistant
sizes 480x320 640x480 800x480 1024x600 1280x720 1280x800 720x720 480x800 480x640 800x1280
env HA_DEMO empty

wait 900
shot empty
check empty
expect text "No favourites yet"
key down
wait 300
expect text "No rooms"
expect noquit
