title Home Assistant: empty states: no favourite yet, no area (only Favourites and All), no room in All
sizes 480x320 640x480 800x480 1024x600 1280x720 1280x800 720x720 480x800 480x640 800x1280
env HA_DEMO empty

wait 1600
shot empty
check empty
expect text "No favourites yet. Open a device (in All, or by its name here) and add it."
expect text "All"
key pgdn
wait 600
shot empty-all
check empty-all
expect text "No favourites yet"
key down
key down
wait 300
expect text "No rooms"
expect noquit
