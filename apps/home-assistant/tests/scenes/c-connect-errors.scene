title Home Assistant: the failure lines of the Connect page: server unreachable, login refused on the phone
sizes 480x320 640x480 800x480 1024x600 1280x720 1280x800 720x720 480x800 480x640 800x1280
env HA_DEMO connect-unreachable

wait 600
shot unreachable
check unreachable
expect text "Cannot reach Home Assistant at homeassistant.local:8123. Check the server address."
expect noquit
