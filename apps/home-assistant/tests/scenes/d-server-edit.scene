title Home Assistant: the Server address field: the fallback keyboard with no keyboard connected, gone with one; a bad address, then a new one
sizes 480x320 640x480 800x480 1024x600 1280x720 1280x800 720x720 480x800 480x640 800x1280
env HA_DEMO connect

wait 500
key enter
wait 400
shot field-osk
check field-osk
expect osk on
expect text "Server address"
keyboards 1
wait 1500
expect osk off
shot field-keyboard
check field-keyboard
key backspace
type " x"
key enter
wait 300
expect text "The port must be a number (8123)"
shot field-bad
check field-bad
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
type "192.168.68.178:8123"
key enter
wait 600
expect text "192.168.68.178"
expect text "http://192.168.68.178:8123"
shot new-address
check new-address
expect noquit
