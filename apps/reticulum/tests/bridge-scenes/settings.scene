# Settings: Keep running (the user unit is enabled and disabled), the name (stored by the bridge, nothing sent), My
# address, and Stop the service (a question first). The unit is a fake: nothing is enabled on this machine.
# fake-scenario: fresh
# expect-verbs: identity.name, service.stop
# systemctl-has: enable reticulum
# systemctl-has: disable reticulum
title Reticulum: settings
sizes 640x480 480x320 800x480 720x720 1280x720 480x800 480x640

wait 1500
key down
key down
key down
key down
key enter
wait 700
shot settings
expect text "Keep running"
expect text "off"
expect text "Alerts show a message and beep. They only work while Keep running is on."
expect text "New message alerts"

# Keep running on, then off
key enter
wait 600
shot keep-on
expect text "on"
key enter
wait 600
expect text "off"

# the name
key down
key down
key enter
wait 300
expect osk on
shot name-field
type "Kitchen deck"
key enter
wait 700
shot name-set
expect text "Kitchen deck"

# my address: the whole text
key down
key enter
wait 300
shot address
key esc
wait 200

# Stop the service: asked first
key down
key enter
wait 300
shot stop-dialog
expect text "Stop the service?"
tap "Cancel"
wait 300
expect notext "Stop the service?"
key enter
wait 300
key right
wait 200
key enter
wait 1200
shot stopped
expect text "service: stopped"
expect text "Start the service"
expect text "You stopped it."
key enter
wait 1500
expect text "service: running  OK"
key esc
expect quit
