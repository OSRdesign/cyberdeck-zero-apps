# Phase P2, Settings: the New message alerts row switches the bridge's alert setting (a toast and a beep for a new
# message, default off) and says what it needs. Nothing is sent.
# fake-scenario: chat
# expect-verbs: settings.set
# forbid-verbs: messages.send, announce
title Reticulum: new message alerts
sizes 640x480 480x320 800x480 480x800 480x640

wait 1500
key end
key enter
wait 700
key down
wait 200
shot alerts-off
expect text "New message alerts"
expect text "Alerts show a message and beep. They only work while Keep running is on."
key enter
wait 600
shot alerts-on
expect text "on"
key enter
wait 600
expect notext "on"
key esc
wait 200
key esc
expect quit
