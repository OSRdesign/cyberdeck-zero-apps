# Phase P2, My address: Copy address (shows the address), Announce myself (the question names the connection that may
# send, Cancel does nothing, the primary button makes the one announcement request). Announcing is never automatic.
# fake-scenario: chat
# expect-verbs: announce
# announce-requests: 1
# forbid-verbs: messages.send, messages.retry
title Reticulum: announce myself
sizes 640x480 480x320 800x480 480x800 480x640

wait 1500
key down
key enter
wait 600
key end
key enter
wait 600
shot my-address
expect text "329a 5b7e 0d1f 4c8a 9b2e 6d30 71c2 c109"

# Copy address
key end
key up
key enter
wait 500
shot copied
expect text "Address copied"
key enter
wait 300

# Announce myself: Cancel does nothing
key end
key enter
wait 400
shot announce-confirm
expect text "Announce myself?"
key esc
wait 300
expect notext "Announce myself?"

# the primary button: the one request
key enter
wait 400
key enter
wait 900
shot announced
expect text "Sent"
key enter
wait 300
key esc
wait 200
key esc
wait 200
key esc
expect quit
