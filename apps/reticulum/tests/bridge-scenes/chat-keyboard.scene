# Phase P2 with a physical keyboard only (the on-screen keyboard never shows): Messages, a conversation whose field is ready
# for typing at once, Enter sends, Esc stops typing, a second Esc goes back; Up from the field goes to the bubbles, Right
# opens More. One message is sent, by Enter.
# fake-scenario: chat
# expect-verbs: messages.send, messages.history
# message-requests: 1
title Reticulum: contacts and messages by keys alone
sizes 640x480 480x320 800x480 480x800 480x640

keyboards 1
wait 1500
key enter
wait 600
key enter
wait 900
expect osk off
type "Hello"
wait 300
expect text "282 left"
shot kb-compose
key enter
wait 1500
shot kb-sent
expect text "287 left"

# Up goes to the bubbles (Page Up scrolls them), Right opens More, Esc and Left come back
key esc
wait 300
key up
key pgup
key end
key right
wait 600
expect text "Delete conversation"
shot kb-options
key left
wait 600
key esc
wait 400
key esc
wait 300
key esc
wait 300
key esc
expect quit
