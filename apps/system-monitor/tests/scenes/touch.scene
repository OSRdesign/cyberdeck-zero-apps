# Touch only (the Pi 3A+ way): one tap on a tile opens its page (a tile is a large target), a drag scrolls the page,
# the header Esc goes back, a tap on a footer item opens it, and at the overview the header Esc ends the app.
title System Monitor: touch only
env SYSTEM_MONITOR_FIXTURE pi-3a-plus:undervoltage
sizes 640x480 800x480 720x720 1280x720 1024x600

wait 600
tap "Temperature"
wait 1200
shot touch-thermal
expect text "CPU temperature"
drag 0.5 0.85 0.5 0.55
wait 800
shot touch-drag
tap "Esc"
wait 500
expect text "Temperature"
tap "System"
wait 800
expect text "Model"
tap "Esc"
wait 500
shot touch-back
expect text "Power"
expect noquit
tap "Esc"
expect quit
