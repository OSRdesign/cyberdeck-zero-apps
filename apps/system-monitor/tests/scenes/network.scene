# The Network page on the deck, opened by a tap on its tile: Wi-Fi with its name, signal and bit rate (from iw), the
# address, the rates and the totals, Bluetooth.
title System Monitor: Network page
env SYSTEM_MONITOR_FIXTURE pi-zero-2w:busy
sizes 640x480 800x480 720x720 1280x720 1024x600

wait 400
expect text "wlan0 -52 dBm"
tap "Network"
wait 1500
shot network
expect text "WLAN0 (WI-FI)"
expect text "State"

# a read-only list: each Down scrolls one row (Network is the 4th row)
key down
key down
key down
wait 600
shot network-wifi
expect text "DeckNet"
expect text "Bit rate"

key down
key down
key down
key down
key down
key down
key down
wait 600
shot network-end
expect text "Bluetooth"
expect noquit
