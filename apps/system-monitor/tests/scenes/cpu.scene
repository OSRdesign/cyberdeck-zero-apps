# The CPU page (Pi Zero 2 W at work), opened by one tap on the CPU tile: the history chart over each core, the
# frequency, the governor, the load, the tasks, the uptime and the top 5 processes by CPU; All processes opens the
# Processes page sorted by CPU; Esc comes back step by step.
title System Monitor: CPU page, All processes
env SYSTEM_MONITOR_FIXTURE pi-zero-2w:busy
sizes 640x480 800x480 720x720 1280x720 1024x600

wait 400
tap "CPU"
wait 1200
shot cpu
expect text "Total"
expect text "Core 0"
expect noquit

key down
key down
key down
key down
key down
key down
key down
key down
key down
wait 600
shot cpu-top
expect text "TOP PROCESSES BY CPU"

key down
key down
key down
key down
key down
key down
key down
wait 600
shot cpu-all
expect text "All processes"
key enter
wait 1200
shot processes-cpu
expect text "Sort by"
expect text "chromium"

key esc
wait 300
expect text "All processes"
key esc
wait 300
expect text "Power OK"
expect noquit
key esc
expect quit
