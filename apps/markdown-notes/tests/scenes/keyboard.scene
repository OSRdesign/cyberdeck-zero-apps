# Markdown Notes: the typing pages with the on-screen keyboard (the shared rule): no keyboard (keyboards 0) the keyboard
# shows for Open or create (only the field above it: the guidelines' rule at 640x480), for New note, and for the editor
# (the text above it; the keyboard's Ctrl then o opens the options box); a keyboard connecting (keyboards 1) takes it
# away; APPLAUNCH_OSK=force (osk force, the HackBerry) brings it back with the keyboard there. Nothing is typed (every
# size shares the vault).
title Markdown Notes: on-screen keyboard (keyboards 0, 1, osk force)
env NOTES_VAULT /tmp/markdown-notes-scene-vault
# notes open in the editor here (build.sh writes open_in=editor in this settings folder)
env XDG_CONFIG_HOME /tmp/markdown-notes-scene-config-editor
sizes 640x480 800x480 720x720 1280x800

keyboards 0
wait 700
key enter
wait 600
expect osk on
shot open-osk
keyboards 1
wait 1500
expect osk off
shot open-keyboard
osk force
wait 1500
expect osk on
shot open-forced
osk auto
keyboards 0
wait 600
tap "Esc"
wait 400
# Home: New note (the fifth row)
key down
key down
key down
key down
key enter
wait 600
expect osk on
expect text "Create"
shot new-osk
tap "Esc"
wait 400
# Home again (New note selected): All notes, its last note (it opens in the editor)
key home
key down
key enter
wait 400
key end
key enter
wait 600
expect osk on
expect text "Editor  ·  83 bytes  ·  Hold 3 s: options"
shot editor-osk
# the keyboard's Ctrl, then o: Ctrl+O, the options box (the keyboard goes for it)
tapkey "Ctrl"
tapkey "o"
wait 600
expect osk off
expect text "Preview"
expect text "Ctrl+E"
shot editor-options-osk
key esc
wait 600
expect osk on
tapkey "Esc"
wait 600
expect osk off
expect text "Editor  ·  83 bytes  ·  Hold 3 s: options"
shot editor-keyboard-away
tap "Esc"
wait 400
tap "Esc"
wait 400
tap "Esc"
expect quit
