# Under the app's minimum (640x480, X-MinSize): an older launcher ignores X-MinSize, so the shared runner shows the
# "needs 640x480" notice instead of the app, which closes on any key.
title Markdown Notes: screens under 640x480
env NOTES_VAULT /tmp/markdown-notes-scene-vault
env XDG_CONFIG_HOME /tmp/markdown-notes-scene-config
sizes 480x320 640x400 480x800

shot notice
expect noquit
key down
expect quit
