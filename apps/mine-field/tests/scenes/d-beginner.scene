title Mine Field: the beginner board derived from the screen: it fits, cells stay square, nothing to pan
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
env MINEFIELD_TEST_DATA d-beginner
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_PREFS preset=beginner
env MINEFIELD_TEST_DUMP /tmp/mf-dump-d-beginner.txt

wait 300
shot level
check level
expect notext "@OVERFLOW"
expect text "Dig"
expect text "Hint"
expect text "Menu"
