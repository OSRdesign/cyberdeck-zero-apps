title Mine Field: Same board starts the very board again, first dig included
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
env MINEFIELD_TEST_DATA g-win-same-board
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DIMS 9x9x10,16x16x40,30x16x99
env MINEFIELD_TEST_SETUP "dig 2,2;safeleft"
env MINEFIELD_TEST_PREFS anim=2

wait 300
tap "@safe"
wait 1500
expect text "You won!"
@640x480 tap "Same board"
@800x480 tap "Same board"
@720x720 tap "Same board"
@1024x600 tap "Same board"
@1280x720 tap "Same board"
@480x800 tap "Replay"
@480x640 tap "Replay"
@800x1280 tap "Same board"
wait 700
shot same
check same
expect notext "You won!"
expect text "Mines 10"
