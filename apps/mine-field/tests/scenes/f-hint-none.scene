title Mine Field: Hint when nothing is certain costs nothing
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
env MINEFIELD_TEST_DATA f-hint-none
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 25
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DIMS 9x9x10,16x16x40,30x16x99
env MINEFIELD_TEST_SETUP "dig 2,2;solve"

wait 300
tap "Hint"
wait 300
expect text "Nothing certain here"
expect notext "+10 s"
shot hint-none
check hint-none
