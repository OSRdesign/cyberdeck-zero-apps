title Mine Field: a board setting changed in a game in progress starts with the next game
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
env MINEFIELD_TEST_DATA k-settings-pending
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DIMS 9x9x10,16x16x40,30x16x99
env MINEFIELD_TEST_SETUP "dig 2,2"

wait 300
key m
wait 200
key down
key down
key down
key down
key down
key enter
wait 300
key enter
wait 200
key esc
wait 200
key esc
wait 300
shot pending
check pending
expect text "New board settings start with the next game"
