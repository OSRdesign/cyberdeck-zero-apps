title Mine Field: a new game before the first dig costs nothing and asks nothing
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
env MINEFIELD_TEST_DATA l-newgame-ready
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DIMS 9x9x10,16x16x40,30x16x99

wait 300
tap "@new"
wait 400
expect notext "Start a new game?"
expect text "Time 0"
shot ready
check ready
