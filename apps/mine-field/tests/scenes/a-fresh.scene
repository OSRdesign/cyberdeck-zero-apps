title Mine Field: a fresh Beginner board, landscape (dock column with the readouts) and portrait (strip over the board, dock under it)
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
env MINEFIELD_TEST_DATA a-fresh
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1

wait 300
shot fresh
check fresh
expect notext "@OVERFLOW"
expect text "Dig"
expect text "Hint"
expect text "Menu"
expect noquit
