title Mine Field: the first dig lays the board and floods open an area, the clock starts
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
env MINEFIELD_TEST_DATA b-first-dig
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DIMS 9x9x10,16x16x40,30x16x99

wait 300
tap "@c2,2"
wait 600
shot dug
check dug
expect notext "Preparing"
expect text "Mines 10"
tap "@c2,2"
wait 200
check again
expect noquit
