title Mine Field: the dock at 8.50 px per mm on every size, then a dug board
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
ppmm 850
env MINEFIELD_TEST_DATA z-dock-850
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DUMP /tmp/mf-dump-z-dock-850.txt

wait 300
shot dock
check dock
expect notext "@OVERFLOW"
tap "@c2,2"
wait 600
shot dug
check dug
expect notext "@OVERFLOW"
