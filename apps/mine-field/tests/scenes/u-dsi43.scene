title Mine Field: Beginner, Intermediate and Expert on the dsi43: all fit the screen
sizes 800x480 480x800
ppmm 850
env MINEFIELD_TEST_DATA u-dsi43
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DUMP /tmp/mf-dump-u-dsi43.txt

wait 300
shot beginner
check beginner
expect notext "@OVERFLOW"
key m
wait 200
key down
key down
key enter
wait 300
shot difficulty
check difficulty
key down
key enter
wait 600
shot intermediate
check intermediate
expect notext "@OVERFLOW"
key m
wait 200
key down
key down
key enter
wait 300
key down
key down
key enter
wait 600
shot expert
check expert
expect notext "@OVERFLOW"
