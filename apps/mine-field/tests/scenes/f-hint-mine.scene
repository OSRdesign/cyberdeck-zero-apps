title Mine Field: Hint on a mine for sure
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
env MINEFIELD_TEST_DATA f-hint-mine
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 19
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DIMS 9x9x10,16x16x40,30x16x99
env MINEFIELD_TEST_SETUP "dig 2,2;solve"

wait 300
tap "Hint"
wait 300
expect text "Mine here: flag it"
expect text "+10 s"
shot hint-mine
check hint-mine
