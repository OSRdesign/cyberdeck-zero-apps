title Mine Field: Beginner, Intermediate and Expert on the pi4b-5in: all fit the screen
sizes 800x480 480x800
ppmm 741
env MINEFIELD_TEST_DATA u-pi4b-5in
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DUMP /tmp/mf-dump-u-pi4b-5in.txt

wait 300
shot beginner
check beginner
expect notext "@OVERFLOW"
key m
wait 200
key down
key down
key enter
wait 300
shot difficulty
check difficulty
key down
key enter
wait 600
shot intermediate
check intermediate
expect notext "@OVERFLOW"
key m
wait 200
key down
key down
key enter
wait 300
key down
key down
key enter
wait 600
shot expert
check expert
expect notext "@OVERFLOW"
