title Mine Field: the menu
sizes 640x480 800x480 720x720 1024x600 1280x720 480x800 480x640 800x1280
env MINEFIELD_TEST_DATA k-menu
env MINEFIELD_TEST_RESET 1
env MINEFIELD_TEST_SEED 7
env MINEFIELD_TEST_PROBES 1
env MINEFIELD_TEST_DIMS 9x9x10,16x16x40,30x16x99
env MINEFIELD_TEST_SETUP "dig 2,2"

wait 300
tap "Menu"
wait 300
shot menu
check menu
expect text "Resume"
expect text "Difficulty"
expect text "Best times"
expect text "Statistics"
expect text "Settings"
key end
wait 300
shot menu-end
check menu-end
expect text "0.1.1"
key esc
wait 300
expect notext "Resume"
expect text "Mines 10"
key m
wait 200
key down
key enter
wait 300
expect text "Start a new game?"
