# Mesh Hop 0.2.0 phase 2: contact details, groups, select mode, bulk delete (C8, C1, C3).
# Run with:  SIMARGS="--contacts 8 --manual-add --new-nodes 3 --slow-remove 0.4"  (12 contacts, manual add mode, 3 strangers advert, slow deletes)
# P3: the page is tapped by label (the action bar's cells, the dialogs' rows, the contacts' names); sorted by name first, so the
# first rows are Alice, Bob, Hilltop repeater, Node 000 Alice ...
wait 6500
key enter
wait 300
key tab
wait 600
type s
wait 900
say == contacts (expect tab=Contacts contacts=12 shown=12 pending=3 select=0 groups=0 sort=name first='Alice')
dump
shot p01-contacts-toolbar

# the details of a chat contact by touch (0.7.0: a tap on a chat contact opens its conversation, so its Options): a 3 s hold on the
# first row opens "Options for Alice" (Message, Details, Groups, Delete), Details opens its details
hold "Alice" 3400
wait 500
say == the Options of a chat contact (expect popup=menu popup_title='Options for Alice')
dump
expect text "Message"
expect notext "Manage"
shot p01b-options
tap "Details"
wait 400
say == details of the first row (expect detail=1 detail_name='Alice')
dump
shot p02-detail

# groups of this contact: there is none yet, so the list offers a new group
tap "Groups"
wait 500
say == groups pick list (expect popup=list popup_title='Groups of this contact')
dump
shot p03-groups-list
key enter
wait 400
type Family
shot p04-new-group-editor
key enter
wait 500
say == the group exists and holds the contact (expect groups=1 notice='Group Family made with 1 contact')
dump
key esc
wait 300

# select mode (More > Manage contacts, the third row of the menu): mark three rows by touch, the bar changes, Delete shows the count
tap "More"
wait 500
tap "Manage contacts"
wait 400
say == select mode (expect select=1 selected=0)
dump
tap "Alice"
tap "Bob"
tap "Hilltop repeater"
wait 300
say == three marked (expect select=1 selected=3)
dump
shot p05-select-marked

# the Select... menu: not heard for 7 days or more
tap "Select..."
wait 400
say == the select list (expect popup=list popup_title='Select contacts')
dump
shot p06-select-menu
key esc
wait 300

# the Group... button: a new group with the marked contacts, typed name
tap "Group..."
wait 400
say == the group menu (expect popup=menu popup_title='Groups')
dump
shot p07-group-menu
key down
key down
key enter
wait 400
type Hikers
key enter
wait 500
say == a second group with 3 contacts, select mode left (expect groups=2 select=0)
dump

# the group filter (Filter > Group): only Hikers
tap "Filter ▼"
wait 500
tap "Group"
wait 400
say == the group pick list (expect popup=list popup_title='Show which group?')
dump
shot p08-group-filter
key down
key down
key enter
wait 900
say == Hikers shown (expect shown=3 group='Hikers')
dump
shot p09-group-shown
tap "Filter ▼"
wait 500
tap "Group"
wait 400
key home
key enter
wait 900
say == all contacts again (expect shown=12 group='')
dump

# bulk delete with the keyboard: X, mark with Enter, D, the confirmation names the count, No first
type x
wait 300
key enter
key down
key enter
key down
key enter
wait 300
say == three marked by keys (expect select=1 selected=3)
dump
type d
wait 500
say == confirmation with the count (expect popup=confirm popup_title='Delete 3 contacts?')
dump
shot p10-delete-confirm
key esc
wait 300
say == No: nothing deleted (expect popup=none contacts=12 select=1)
dump
type d
wait 400
type y
wait 600
say == progress box (expect popup=progress)
dump
shot p11-progress
wait 3000
say == deleted one by one, select mode left (expect contacts=9 select=0 popup=none bulk=idle/3/0)
dump
shot p12-after-delete

# the details of a contact (the first row, selected after Home; 0.7.0: I opens its Options, Details its details), then Delete from
# its bar: Yes / No first
key home
wait 300
type i
wait 400
tap "Details"
wait 400
say == details (expect detail=1 detail_name='Node 000 Alice')
dump
tap "Delete"
wait 400
say == the delete box of one contact (expect popup=confirm popup_title='Delete contact?')
dump
shot p13-detail-delete
type y
wait 1500
say == one contact went (expect contacts=8 detail=0 popup=none)
dump