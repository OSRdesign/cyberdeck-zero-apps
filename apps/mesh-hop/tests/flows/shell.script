# Mesh Hop P2b (the shell): Home (a list: Chats, Contacts, Settings, each with a chevron and a short state), the header (title, Esc
# button, status strip), the caption line (the board and the notices), the key hint line (only while a keyboard is there), the three
# pages, the dialogs (Quit, a menu, a question, a choice, an editor, the Position box) and the sub-pages, at any size, the default
# simulated board. There is no tab row: the Esc button of a page goes back to Home, the one of Home asks "Quit Mesh Hop?".
# Run at each size:   SIZE=1280x720 SCRIPT=shell.script sh ui_smoke.sh      (run_flows.sh stage runs the five)
# Coordinates (rare) are the 640x480 layout's of the page bodies: mesh-hop-script moves them to where the body is. The shell is
# tapped by its labels. `fill` checks that the page bodies fill the width (P4: no 640 px stage any more); `check` runs the shared
# layout checks and the size rules on every control (Home, the header, the pages, the dialogs): any finding fails the run.
wait 3500
fill
say == Home with a keyboard (the hint line at the bottom) (expect home=1)
dump
shot h01-home-keyboard
check home-keyboard
keyboard off
say == Home without a keyboard: no hint line
shot h02-home
check home

# Chats (the first row): without and with the hint line
key enter
wait 600
say == Chats (expect home=0 tab=Chats link=Connected conv=c:0)
dump
shot h03-chats
check chats
keyboard on
say == Chats with a keyboard
shot h03b-chats-keyboard
check chats-keyboard
keyboard off

# a direct conversation (a first tap on its row selects it, the second opens it: one pane, its page; two panes, the entry takes the
# keys, the keyboard's here): the bar has Options and Details
keyboard on
tap "Alice"
tap "Alice"
wait 600
say == a direct conversation (expect conv=d:... conv_open=1)
dump
shot h04-conversation-options
check conversation

# the Options button opens the options of the conversation (a menu in a dialog)
tap "Options"
wait 800
say == the options (expect popup=menu)
dump
shot h05-options-dialog
check options-dialog
key esc
wait 300
say == popup closed (expect popup=none)
dump

# back to Home (one pane: the list first; two panes: the list's keys first), then Contacts (a Home row: the selection is on Chats,
# Down moves to Contacts)
key esc
key esc
wait 400
keyboard off
say == Home again (expect home=1)
dump
key down
key enter
wait 600
say == Contacts (expect home=0 tab=Contacts shown=4)
dump
shot h06-contacts
check contacts
keyboard on
say == Contacts with a keyboard: the hint line at the bottom
shot h06b-contacts-keyboard
check contacts-keyboard
keyboard off

# Settings by the Tab key (the next page), and without a keyboard
key tab
wait 800
say == Settings (expect home=0 tab=Settings)
dump
shot h07-settings
check settings
keyboard on
say == Settings with a keyboard
shot h07b-settings-keyboard
check settings-keyboard

# a question: Reboot the board (the last rows of Settings: Reboot, Factory reset, Undo, Save)
key end
key up
key up
key up
key enter
wait 800
say == a question in a dialog (expect popup=confirm)
dump
shot h08-confirm-dialog
check confirm-dialog
key esc
wait 300

# a choice with arrows: Bandwidth
key home
key down
key down
key down
key down
key down
key down
key down
key enter
wait 800
say == a choice (expect popup=choice)
dump
shot h09-choice-dialog
check choice-dialog
key esc
wait 300

# an editor: the node name
key home
key down
key down
key down
key down
key enter
wait 800
say == the editor (expect editor=1)
dump
shot h10-editor-dialog
check editor-dialog
key esc
wait 300

# the Position box
key home
key enter
wait 800
say == the Position box (expect pos_box=1)
dump
shot h11-position-dialog
check position-dialog
key esc
wait 300

# a sub-page: the title has one more part, the Esc button goes back one step
key home
key down
key down
key down
key enter
wait 600
say == the packet log (expect log_open=1)
dump
shot h12-subpage
check subpage
tap "Esc"
wait 400

# a page's Esc button goes back to Home; a short Esc of the keyboard at Home says how to leave (in the caption line)
tap "Esc"
wait 400
say == Home (expect home=1)
dump
key esc
wait 300
say == the caption line says how to leave
shot h13-caption-notice
check caption-notice

# Quit? (the Esc button of Home)
tap "Esc"
wait 800
say == the question of the Esc button at Home (expect popup=confirm popup_title='Quit Mesh Hop?')
dump
shot h14-quit-dialog
check quit-dialog
tap "Cancel"
wait 400
say == Cancel stays (expect popup=none)
dump
expect notext "Quit Mesh Hop?"
