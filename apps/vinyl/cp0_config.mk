# Vinyl's toolkit switches (apps/_common/README.md, "Toolkit switches of one app").
# 0.8.0: the toolkit's shared sudo password prompt, for Add and Remove of a network share (owner decision D1 of 2026-11-22:
# the password is asked at every Add and Remove; the root step is the launcher's /usr/libexec/cyberdeckzero/cyberdeckzero-share).
# The headless harness compiles no prompt (the scenes answer from data).
CONFIG_CP0_LVGL_INIT_SUDO=y
