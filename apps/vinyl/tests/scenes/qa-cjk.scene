title Vinyl: CJK names and tags (Japanese, Chinese, Korean) on now playing and in the browser, through the launcher's Noto Sans CJK
sizes 640x480 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_CJK 1
env VINYL_DEMO_STATE playing

wait 1200
shot 01-now-cjk
expect esc
expect text "あの夏へ"
expect text "久石譲"
key b
wait 400
shot 02-browser-cjk
expect text "한국"
expect text "月亮代表我的心"
tap "한국"
wait 400
shot 03-browser-cjk-folder
expect text "서른 즈음에"
expect noquit
