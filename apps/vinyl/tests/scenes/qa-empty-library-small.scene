title Vinyl P2b: the empty library (no music yet and its button, Music folders in choose mode with nothing to choose, Search finds nothing) (480x320 and 320x480, their real density)
sizes 480x320 320x480
ppmm 630
allow-small
env VINYL_DEMO 1
env VINYL_DEMO_EMPTY 1
env VINYL_DEMO_LIBRARY full
env VINYL_DEMO_PAGE library
keyboards 1
wait 1200
shot 01-no-music
expect text "LIBRARY, 0 TRACKS"
expect text "No music yet"
expect text "Put music in the Music folder or plug in a USB drive. Vinyl finds it by itself."
expect text "Add a music folder"
expect noquit
# the button opens Music folders in the Browser's choose mode at once (no folder yet: nothing to use)
tap "Add a music folder"
wait 700
shot 02-choose-empty
expect text "Use folder"
tap "Use folder"
wait 400
expect text "Open a folder first."
key esc
wait 400
shot 03-folders-empty
expect text "MUSIC FOLDERS, 0"
expect text "Add a folder"
key esc
wait 400
expect text "No music yet"
# Search an empty library: nothing found
tap "Search"
wait 500
type abc
wait 900
shot 04-search-empty-library
expect text "Songs, albums, artists and genres were searched. Two letters match the start of a title."
key esc
wait 400
expect text "No music yet"
expect noquit
