title Vinyl P2a: the volume chip in dB (Volume steps 0.1 dB: the output's real level, never the percent; a box too narrow for "-24.8 dB" shows "-24.8"), "+" and "-" move it by the step
sizes 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing
env VINYL_DEMO_VOLSTEPS 0.1

wait 1200
shot 01-now-db
expect esc
@800x480,720x720,480x800 expect text "-24.8 dB"
@480x480,480x640 expect text "-24.8"
expect notext "60"
@800x480 tapxy 0.921 0.848
@480x480 tapxy 0.881 0.922
@720x720 tapxy 0.901 0.919
@480x800 tapxy 0.849 0.936
@480x640 tapxy 0.809 0.928
wait 300
shot 02-now-db-up
@800x480,720x720,480x800 expect text "-24.7 dB"
@480x480,480x640 expect text "-24.7"
@800x480 tapxy 0.749 0.848
@480x480 tapxy 0.629 0.922
@720x720 tapxy 0.636 0.919
@480x800 tapxy 0.486 0.936
@480x640 tapxy 0.489 0.928
wait 300
@800x480 tapxy 0.749 0.848
@480x480 tapxy 0.629 0.922
@720x720 tapxy 0.636 0.919
@480x800 tapxy 0.486 0.936
@480x640 tapxy 0.489 0.928
wait 300
shot 03-now-db-down
@800x480,720x720,480x800 expect text "-24.9 dB"
@480x480,480x640 expect text "-24.9"
expect noquit
