title Vinyl P2b: the hub while the library is being scanned (the strip over the mini player: Scanning: 388 of about 1,200 files, its bar) and the Library settings with the scan's block
sizes 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_LIBRARY full
env VINYL_DEMO_STATE playing
env VINYL_DEMO_PAGE library
env VINYL_DEMO_SCAN scanning
keyboards 1
wait 1200
shot 01-hub-scanning
expect text "LIBRARY, 166 TRACKS SO FAR"
expect text "Scanning: 388 of about 1,200 files"
expect text "Artists"
expect text "Search"
expect noquit
# the Library settings while a scan runs: the cream block with its bar; Rescan now is inert
key m
wait 500
tap "Library"
wait 700
shot 02-settings-scanning
expect text "SCANNING, 388 OF 1,200"
expect text "You can keep listening. The scan runs at low priority and stops when you leave the page or the board gets hot."
expect text "Rescan now"
key esc
wait 400
expect text "Playback"
