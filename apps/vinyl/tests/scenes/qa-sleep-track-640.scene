title Vinyl P2a: the sleep timer on "This track" (stops at the end of the track that plays, its last 10 s fading) and on "This album or queue" (640x480 (9.01 px/mm))
sizes 640x480
ppmm 901
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing
env VINYL_DEMO_PAGE sleep
env VINYL_DEMO_SLEEP track

wait 900
shot 01-sleep-track
expect text "Stops at the end of this track. The music fades out for its last 10 seconds."
tap "This album or queue"
wait 400
shot 02-sleep-album
expect text "Stops at the end of this album or queue. The music fades out for its last 10 seconds."
key left
wait 400
shot 03-menu-album
expect text "This album"
tap "Sleep timer"
wait 400
tap "Off"
wait 400
shot 04-sleep-off
expect notext "Stops at the end of this album or queue. The music fades out for its last 10 seconds."
expect noquit
