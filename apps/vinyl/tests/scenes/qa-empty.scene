title Vinyl: an empty library (no music folder, no saved state): now playing with nothing, the browser's notice row, the empty queue
sizes 640x480 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_EMPTY 1
env VINYL_DEMO_PAGE now

wait 1000
shot 01-now-empty
expect esc
expect text "Nothing playing"
expect text "Pick a folder"
expect text "or a playlist"
key esc
wait 300
shot 02-browser-empty
expect text "No music folder"
expect text "Copy music to ~/Music"
key q
wait 300
shot 03-queue-empty
expect text "EMPTY QUEUE"
key left
wait 300
key esc
expect quit
