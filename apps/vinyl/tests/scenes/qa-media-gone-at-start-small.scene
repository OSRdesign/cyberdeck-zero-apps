title Vinyl P2b: a start with a saved queue on a drive that is not there (B50): the entries are dropped before the first screen, Vinyl opens on the Library hub, no 'file is gone' (480x320 and 320x480, their real density)
sizes 480x320 320x480
ppmm 630
allow-small
env VINYL_DEMO 1
env VINYL_DEMO_LIBRARY full
env VINYL_DEMO_DRIVES unmounted
env VINYL_DEMO_DRIVE_QUEUE gone
keyboards 1
wait 1200
shot 01-hub-at-start
expect text "Folders"
expect text "LIBRARY, 166 TRACKS"
expect notext "Flash Song"
expect noquit
key q
wait 500
shot 02-queue-is-empty
expect text "EMPTY QUEUE"
expect notext "Flash Song"
key esc
wait 500
expect text "Folders"
expect noquit
