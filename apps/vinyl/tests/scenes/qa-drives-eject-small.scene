title Vinyl P2b: Music folders with drives: one Vinyl mounted (Eject), one plugged in and not mounted (dimmed); Eject unmounts it and says so (480x320 and 320x480, their real density)
sizes 480x320 320x480
ppmm 630
allow-small
env VINYL_DEMO 1
env VINYL_DEMO_LIBRARY full
env VINYL_DEMO_STATE playing
env VINYL_DEMO_PAGE library
env VINYL_DEMO_DRIVES vinyl
keyboards 1
wait 1200
key m
wait 500
tap "Library"
wait 700
tap "Music folders"
wait 700
shot 01-music-folders-drives
expect text "SANDISK (USB drive)"
@480x320,640x480,800x480,480x480,720x720 expect text "mounted by Vinyl"
@480x320,640x480,800x480,480x480,720x720 expect text "Generic Flash Disk (USB drive)"
@480x320,640x480,800x480,480x480,720x720 expect text "not mounted"
expect text "Eject"
expect text "Remove selected folder"
key down
key down
shot 02-sandisk-selected
expect text "Eject SANDISK"
tap "Eject SANDISK"
wait 900
shot 03-ejected
expect text "SANDISK ejected. You can unplug it."
expect notext "mounted by Vinyl"
tap "SANDISK ejected. You can unplug it."
wait 300
key esc
wait 300
key esc
wait 300
expect text "Playback"
