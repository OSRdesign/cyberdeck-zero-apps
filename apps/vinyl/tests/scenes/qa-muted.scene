title Vinyl: the output muted (the launcher's mute key, another app): the volume group shows Muted, never the level; "-" does nothing, "+" brings the sound back at its level (640x480: qa-640-muted, 480x320 and 320x480: qa-muted-small)
sizes 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing
env VINYL_DEMO_MUTED 1

wait 1200
shot 01-now-muted
expect esc
expect notext "60"
# the muted word as drawn (the level's size, down to the toolkit's caption size; else a shorter word; else the mark
# alone): qa-info.txt's muted= line is read from these lines, which the harness checks against the screen
@480x480,480x640 expect text "Off"
@720x720,480x800 expect text "Mute"
@800x480 expect notext "Muted"
@800x480 expect notext "Mute"
@800x480 expect notext "Off"
wait 300
shot 02-now-muted-volume
expect notext "60"
# "-" while muted does nothing
@800x480 tapxy 0.801 0.848
@480x480 tapxy 0.629 0.922
@720x720 tapxy 0.636 0.919
@480x800 tapxy 0.486 0.936
@480x640 tapxy 0.489 0.928
wait 300
expect notext "60"
# "+" brings the sound back at its level
@800x480 tapxy 0.921 0.848
@480x480 tapxy 0.881 0.922
@720x720 tapxy 0.901 0.919
@480x800 tapxy 0.849 0.936
@480x640 tapxy 0.809 0.928
wait 300
shot 03-now-unmuted
expect notext "Muted"
expect text "60"
expect noquit
