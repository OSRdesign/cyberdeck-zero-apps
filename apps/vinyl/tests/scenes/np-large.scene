title Vinyl now playing, 800x480 (draft NowPlaying-800x480): the queue pane and now playing
sizes 800x480
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing

wait 1200
shot now-playing
expect esc
expect text "QUEUE, 20 TRACKS"
expect text "Amerie, 1 Thing (Siik Remix)"
expect text "Equalizer"
expect noquit
