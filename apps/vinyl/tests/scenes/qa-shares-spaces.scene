title Vinyl 0.8.1: Add a network folder with spaces in the share and the folder ("My Share", "Music/My Albums"): typed, valid (no refusal line), the default name made with underscores
sizes 800x480
env VINYL_DEMO 1
env VINYL_DEMO_LIBRARY full
env VINYL_DEMO_STATE playing
env VINYL_DEMO_PAGE library
env VINYL_DEMO_SHARES 1
keyboards 1
wait 1200
key m
wait 500
tap "Library"
wait 700
tap "Music folders"
wait 900
tap "Add a network folder"
wait 500
type 192.168.68.142
key enter
type "My Share"
key enter
type "Music/My Albums"
wait 200
shot 01-typed
expect text "My Share"
expect text "Music/My Albums"
tap "Check and add"
wait 300
expect text "Asking for the password, then checking 192.168.68.142 (up to 10 s)..."
wait 1200
shot 02-added
expect text "Added. Scanning My_Share."
expect text "192.168.68.142 / My Share/Music/My Albums"
expect noquit
