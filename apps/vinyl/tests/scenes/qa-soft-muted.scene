title Vinyl: a board without a sound server whose card has no playback mixer (HDMI on zero8: Vinyl's software level), muted by Vinyl itself at 60 %: the same muted box as a muted card or sink (the mark and "Mute" where both fit, else the mark alone), "-" does nothing, "+" brings 60 back; every QA size (allow-small: the sizes are checked by the other muted scenes)
sizes 480x320 320x480 640x480 800x480 480x480 720x720 480x800 480x640
allow-small
env VINYL_DEMO 1
env VINYL_DEMO_LITE 1
env VINYL_DEMO_STATE playing
env VINYL_DEMO_MUTED 1

wait 1200
shot 01-soft-muted
expect esc
expect notext "60"
@480x320,800x480,720x720,480x800 expect text "Mute"
@320x480,640x480,480x480,480x640 expect notext "Mute"
expect notext "Muted"
expect notext "Off"
# "-" while muted does nothing
@480x320 tapxy 0.550 0.609
@320x480 tapxy 0.486 0.928
@640x480 tapxy 0.720 0.912
@800x480 tapxy 0.749 0.848
@480x480 tapxy 0.629 0.922
@720x720 tapxy 0.636 0.919
@480x800 tapxy 0.486 0.936
@480x640 tapxy 0.489 0.928
wait 300
expect notext "60"
# "+" brings 60 % back
@480x320 tapxy 0.875 0.609
@320x480 tapxy 0.848 0.928
@640x480 tapxy 0.904 0.912
@800x480 tapxy 0.921 0.848
@480x480 tapxy 0.881 0.922
@720x720 tapxy 0.901 0.919
@480x800 tapxy 0.849 0.936
@480x640 tapxy 0.809 0.928
wait 300
shot 02-soft-unmuted
expect notext "Mute"
expect text "60"
expect noquit
