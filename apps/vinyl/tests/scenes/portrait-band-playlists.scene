title Vinyl P2c: the name box with the PDA writing band (480x800, 480x640)
band
sizes 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_LIBRARY full
env VINYL_DEMO_PLAYLISTS list
env VINYL_DEMO_STATE playing
keyboards 0
wait 1200
key q
wait 800
tap "Save as playlist"
wait 900
shot 01-save-band
expect text "20 tracks. Name:"
key esc
wait 700
key b
wait 600
tap "Playlists"
wait 800
tap "Evening"
wait 900
tap "Rename"
wait 900
shot 02-rename-band
expect text "18 tracks. New name:"
key esc
wait 600
expect noquit
