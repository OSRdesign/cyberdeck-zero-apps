title Vinyl P2a: the Menu walk of qa-menu at the other canvases of the P1 scene set (1280x720, 1024x600: the tablet class; 800x600 and 1024x768: two panes), their own densities
sizes 1280x720 1024x600 800x600 1024x768
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing

wait 1200
shot 01-now
expect esc
expect text "Vinyl"
expect text "Evolve 65"
# the bottom row's Menu key (its word)
tap "Menu"
wait 400
shot 02-menu
expect text "TOOLS"
expect text "SETTINGS"
expect text "Sleep timer"
expect text "Playback"
expect text "Output"
expect text "Keys"
expect text "About"
expect notext "Equalizer"
expect notext "Library"
tap "Sleep timer"
wait 400
shot 03-sleep
expect text "STOP PLAYING AFTER"
expect text "This album or queue"
tap "30 minutes"
wait 400
shot 04-sleep-30
expect text "30 minutes"
key left
wait 400
shot 05-menu-timer
expect text "Sleep timer"
tap "Playback"
wait 400
shot 06-playback
expect text "Gapless"
expect text "Remember position in long files"
expect notext "Speed (later)"
expect text "ReplayGain evens out the loudness between tracks."
tap "ReplayGain"
wait 400
shot 07-replaygain
expect text "Track"
expect text "Album"
tap "Album"
wait 400
shot 08-replaygain-album
key left
wait 400
tap "Gapless"
wait 400
shot 09-playback-changed
expect text "Album"
key left
wait 400
tap "Output"
wait 400
expect text "Automatic"
key left
wait 400
expect text "Playback"
tap "Keys"
wait 400
shot 10-keys
expect text "Play or pause"
expect text "Queue, Browse, Output, Menu"
key down
key down
key down
key down
key down
key down
key down
key down
wait 300
shot 11-keys-scrolled
key left
wait 400
tap "About"
wait 400
shot 12-about
expect text "FORMATS"
expect text "THIS OUTPUT"
expect text "LIBRARIES"
key left
wait 400
key left
wait 400
expect text "Evolve 65"
key esc
wait 300
expect text "MUSIC / PHOENIX"
expect noquit
