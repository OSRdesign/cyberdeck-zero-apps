title Vinyl P2b: the Library walk of qa-library at 480x320 (Library-480x320 and the p2b boards) and 320x480 (Library-320x480), their real density (6.3 px/mm: rows 44)
sizes 480x320 320x480
ppmm 630
allow-small
env VINYL_DEMO 1
env VINYL_DEMO_LIBRARY full
env VINYL_DEMO_STATE playing

keyboards 1
wait 1200
shot 01-now
expect esc
expect text "Evolve 65"
# Browse is the Library's hub now (the key B, the Browse button)
key b
wait 500
shot 02-hub
expect text "Folders"
expect text "Playlists"
expect text "Artists"
expect text "Search"
expect text "LIBRARY, 166 TRACKS"
expect noquit
# Playlists are P2c: the row is there, it opens nothing and says so
tap "Playlists"
wait 300
shot 03-playlists-later
expect text "Playlists arrive in a later version."
tap "Playlists arrive in a later version."
wait 300
expect noquit
# Artists: a chevron row opens, a hold of 3 s opens the artist's sheet
tap "Artists"
wait 700
shot 04-artists
expect text "ARTISTS, 25"
expect text "Beach House"
hold "Beach House" 3300
wait 400
shot 05-artist-sheet
expect text "BEACH HOUSE, 3 ALBUMS"
expect text "Play all"
expect text "Play next"
expect text "Add to queue"
expect text "Add to playlist"
expect notext "Track info"
expect text "Hold a row for 3 s, or press Ctrl+O, to open this sheet."
key esc
wait 300
expect notext "Play all"
expect text "ARTISTS, 25"
tap "Beach House"
wait 700
shot 06-artist
expect text "BEACH HOUSE, 3 ALBUMS, 13 TRACKS"
expect text "Teen Dream"
expect text "2010"
tap "Teen Dream"
wait 700
shot 07-album
expect text "TEEN DREAM, 2010, 5 TRACKS"
expect text "Play album"
expect text "1  Lisztomania"
expect text "02:30"
# the track's sheet: hold 3 s; N plays it next, A adds it, I opens its Track info
hold "1  Lisztomania" 3300
wait 400
shot 08-track-sheet
expect text "LISZTOMANIA, BEACH HOUSE"
expect text "Play"
expect text "Play next"
expect text "Add to queue"
expect text "Add to playlist"
expect text "Track info"
expect text "Enter"
key n
wait 400
shot 09-play-next
expect text "Will play next."
tap "Will play next."
wait 300
hold "2  1901" 3300
wait 400
key a
wait 400
expect text "Added to the queue."
tap "Added to the queue."
wait 300
hold "3  Fences" 3300
wait 400
key i
wait 500
shot 10-track-info
expect text "TRACK INFO"
expect text "Format"
expect text "Played"
expect text "File"
expect text "Never"
key esc
wait 400
expect text "TEEN DREAM, 2010, 5 TRACKS"
# Esc steps back one place at a time: album, artist, Artists, the hub
key esc
wait 400
expect text "BEACH HOUSE, 3 ALBUMS, 13 TRACKS"
key esc
wait 400
expect text "ARTISTS, 25"
key esc
wait 400
expect text "LIBRARY, 166 TRACKS"
expect noquit
# Albums, Songs (pages of 40: the highlight walks past the end of the first page), Genres by the keys (the hub kept Artists)
key down
key enter
wait 600
shot 11-albums
expect text "ALBUMS, 38"
key esc
wait 400
key down
key enter
wait 600
shot 12-songs
expect text "SONGS, 166"
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
wait 500
shot 13-songs-paged
expect text "SONGS, 166"
key esc
wait 400
key down
key enter
wait 600
shot 14-genres
expect text "GENRES, 6"
expect text "Alternative"
key enter
wait 600
shot 15-genre-albums
expect text "ALTERNATIVE, 4 ALBUMS"
key esc
wait 300
key esc
wait 400
expect text "LIBRARY, 166 TRACKS"
# Search: a field over the results, results while typing, an album of two discs
tap "Search"
wait 500
shot 16-search-empty
expect text "Search your music"
type fen
wait 900
shot 17-search-fen
expect text "SONGS"
key backspace
key backspace
key backspace
type wolfgang
wait 900
shot 18-search-wolfgang
expect text "ALBUMS"
# Enter hands the keys to the results: the album is the first row
key enter
wait 300
key enter
wait 700
shot 19-album-discs
expect text "Play album"
expect text "DISC 2"
key esc
wait 500
expect text "ALBUMS"
key esc
wait 400
expect text "LIBRARY, 166 TRACKS"
tap "Search"
wait 500
type zzyx
wait 900
shot 20-search-none
expect text "Songs, albums, artists and genres were searched. Two letters match the start of a title."
# Esc leaves the field and the page in one press
key esc
wait 500
expect text "LIBRARY, 166 TRACKS"
expect noquit
# the Library settings: the Menu's Library row
key m
wait 500
expect text "Library"
tap "Library"
wait 700
shot 21-settings
expect text "Music folders"
expect text "Rescan now"
tap "Music folders"
wait 700
shot 22-folders
expect text "MUSIC FOLDERS, 2"
expect text "Add a folder"
expect text "Remove selected folder"
expect text "~/Music"
tap "Remove selected folder"
wait 400
shot 23-remove-refused
expect text "Music and USB drives are always in the library. Only folders you added can be removed."
tap "Music and USB drives are always in the library. Only folders you added can be removed."
wait 300
tap "Add a folder"
wait 700
shot 24-choose
expect text "Use folder"
tap "Amerie"
wait 700
shot 25-choose-folder
tap "Use folder"
wait 700
shot 26-already-there
expect text "That folder is in the library already."
expect text "MUSIC FOLDERS, 2"
key esc
wait 400
expect text "Music folders"
key esc
wait 400
expect text "Playback"
expect noquit
# Esc on the Menu goes back to the hub; Esc at the hub (the app's root) quits (D-30)
key esc
wait 400
expect text "LIBRARY, 166 TRACKS"
expect noquit
key esc
wait 400
expect quit
