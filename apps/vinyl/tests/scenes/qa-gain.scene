title Vinyl P2a: the Playback page with Gain boost (0 to +4 dB, a pick list) and Volume steps (Normal, 1, 0.5, 0.1 dB, a pick list); a choice closes the list; Now playing shows the volume chip in dB after a dB step is chosen
sizes 800x480 480x480 720x720 480x800 480x640 1280x720
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing
env VINYL_DEMO_PAGE playback

wait 900
shot 01-playback
expect text "Gain boost"
expect text "Volume steps"
expect text "Gapless"
tap "Gain boost"
wait 400
shot 02-boost-list
expect text "GAIN BOOST"
expect text "+4 dB"
# a choice closes the pick list (owner's rule): Playback shows the new value
tap "+3 dB"
wait 400
shot 03-playback-boost-3
expect text "+3 dB"
tap "Volume steps"
wait 400
shot 04-steps-list
expect text "VOLUME STEPS"
expect text "0.5 dB"
tap "0.5 dB"
wait 400
shot 05-playback-steps-half
expect text "0.5 dB"
expect text "+3 dB"
tap "Gain boost"
wait 400
tap "Off"
wait 400
shot 06-playback-boost-off
key left
wait 400
key left
wait 600
shot 07-now-db-chip
@800x480 tapxy 0.921 0.848
@480x480 tapxy 0.881 0.922
@720x720 tapxy 0.901 0.919
@480x800 tapxy 0.849 0.936
@480x640 tapxy 0.809 0.928
wait 300
shot 08-now-db-chip-up
@800x480 tapxy 0.749 0.848
@480x480 tapxy 0.629 0.922
@720x720 tapxy 0.636 0.919
@480x800 tapxy 0.486 0.936
@480x640 tapxy 0.489 0.928
wait 300
@800x480 tapxy 0.749 0.848
@480x480 tapxy 0.629 0.922
@720x720 tapxy 0.636 0.919
@480x800 tapxy 0.486 0.936
@480x640 tapxy 0.489 0.928
wait 300
shot 09-now-db-chip-down
expect noquit
