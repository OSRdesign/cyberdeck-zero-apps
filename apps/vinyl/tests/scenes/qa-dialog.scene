title Vinyl: Clear all asks first ("Clear the queue?", Cancel the default; Esc and the header's Esc cancel, Clear clears all but the playing track) (640x480: qa-640-dialog)
sizes 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1

wait 1000
key q
wait 400
key c
wait 300
shot 01-queue-clear-ask
expect esc
expect text "Clear the queue?"
expect text "Cancel"
key esc
wait 300
expect notext "Clear the queue?"
expect text "3 OF 20, 1 H 24 MIN LEFT"
# the header's Esc while it shows: it only cancels (design QA run 4, D-30), the queue page stays
tap "Clear all"
wait 300
expect text "Clear the queue?"
tap "Esc"
wait 300
expect notext "Clear the queue?"
expect text "3 OF 20, 1 H 24 MIN LEFT"
tap "Clear all"
wait 300
expect text "Clear the queue?"
tap "Clear"
wait 400
shot 02-queue-cleared
expect notext "Clear the queue?"
expect text "1 OF 1, 3 MIN LEFT"
expect noquit
