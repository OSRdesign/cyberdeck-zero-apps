title Vinyl P2a: design QA walk of the Menu (the Menu key on now playing; the Menu: Sleep timer, Playback, Output, Keys, About, no row of a later phase; the Sleep timer page and a 30-minute timer with its status line; Playback with its ReplayGain pick list (Track, Album) and the Gapless toggle; Output and back; Keys scrolled; About; Left goes back on every page). 480x320 and 320x480: qa-menu-small; 640x480: qa-menu-640 and qa-menu-deck; the wide canvases: qa-menu-wide. Busy state: none (nothing waits)
sizes 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing

wait 1200
shot 01-now
expect esc
expect text "Vinyl"
expect text "Evolve 65"
# the Menu key: a tap where it has its word (800x480), M (its physical key) on the others
@800x480 tap "Menu"
@480x480 key m
@720x720 key m
@480x800 key m
@480x640 key m
wait 400
shot 02-menu
expect text "TOOLS"
expect text "SETTINGS"
expect text "Sleep timer"
expect text "Playback"
expect text "Output"
expect text "Keys"
expect text "About"
expect notext "Equalizer"
expect notext "Library"
tap "Sleep timer"
wait 400
shot 03-sleep
expect text "STOP PLAYING AFTER"
expect text "This album or queue"
tap "30 minutes"
wait 400
shot 04-sleep-30
expect text "30 minutes"
key left
wait 400
shot 05-menu-timer
expect text "Sleep timer"
tap "Playback"
wait 400
shot 06-playback
expect text "Gapless"
expect text "Remember position in long files"
expect notext "Speed (later)"
expect text "ReplayGain evens out the loudness between tracks."
tap "ReplayGain"
wait 400
shot 07-replaygain
expect text "Track"
expect text "Album"
tap "Album"
wait 400
shot 08-replaygain-album
key left
wait 400
tap "Gapless"
wait 400
shot 09-playback-changed
expect text "Album"
key left
wait 400
tap "Output"
wait 400
expect text "Automatic"
key left
wait 400
expect text "Playback"
tap "Keys"
wait 400
shot 10-keys
expect text "Play or pause"
expect text "Queue, Browse, Output, Menu"
key down
key down
key down
key down
key down
key down
key down
key down
wait 300
shot 11-keys-scrolled
key left
wait 400
tap "About"
wait 400
shot 12-about
expect text "FORMATS"
expect text "THIS OUTPUT"
expect text "LIBRARIES"
key left
wait 400
key left
wait 400
expect text "Evolve 65"
key esc
wait 300
expect text "MUSIC / PHOENIX"
expect noquit
