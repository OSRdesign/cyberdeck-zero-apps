title Vinyl: a one-hour track (h:mm:ss on both sides of the seek bar) on a USB DAC with a long name (the output chip on a row of its own where it would be cut, the output button on square and portrait)
sizes 640x480 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_LONG 1

wait 1200
shot 01-now-long
expect esc
expect text "0:01:14"
expect text "-1:01:16"
@640x480 expect text "Vol 70"
@800x480,480x480,720x720,480x800,480x640 expect text "70"
expect text "USB Audio Device"
key b
wait 400
shot 02-browser-long
key o
wait 400
shot 03-output-long
expect text "USB Audio Device"
key left
wait 300
key esc
expect quit
