title Vinyl: Transition Normal hides Now playing's transition chip (owner, 2026-11-20), ReplayGain Off so no chip is left on that row
sizes 800x480 480x480 720x720 480x800 480x640 1280x720
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing
env VINYL_DEMO_TRANSITION normal
env VINYL_DEMO_RG off

wait 1200
shot 01-now-normal
expect notext "Gapless"
expect notext "Crossfade 5 s"
expect notext "Crossfade 10 s"
expect notext "Crossfade 20 s"
expect noquit
