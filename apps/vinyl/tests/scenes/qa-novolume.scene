title Vinyl: where nothing can change the volume (the server reports no level), a tap on the Vol chip or on the group's "+" says so in a notice
sizes 640x480 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing
env VINYL_DEMO_NOVOLUME 1

wait 1200
expect esc
@640x480 expect text "Vol --"
@640x480 tap "Vol --"
@800x480,480x480,720x720,480x800,480x640 expect text "--"
@800x480 tapxy 0.922 0.849
@480x480 tapxy 0.881 0.922
@720x720 tapxy 0.901 0.919
@480x800 tapxy 0.849 0.936
@480x640 tapxy 0.809 0.928
wait 300
shot 01-now-volume-unavailable
expect text "Volume is not available on this board"
expect noquit
