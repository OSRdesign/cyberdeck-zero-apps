title Vinyl: a tap on the volume chip where nothing can change the volume (the launcher reports none) says so in a notice
sizes 640x480 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing
env VINYL_DEMO_NOVOLUME 1

wait 1200
expect esc
expect text "Vol --"
tap "Vol --"
wait 300
shot 01-now-volume-unavailable
expect text "Volume is not available on this board"
expect noquit
