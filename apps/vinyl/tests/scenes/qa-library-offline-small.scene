title Vinyl P2b: a drive that is gone (owner ruling 2026-11-14: nothing of it is shown: no tracks, no note on the hub, no row in Music folders) (480x320 and 320x480, their real density)
sizes 480x320 320x480
ppmm 630
allow-small
env VINYL_DEMO 1
env VINYL_DEMO_LIBRARY offline
env VINYL_DEMO_STATE playing
env VINYL_DEMO_PAGE library
keyboards 1
wait 1200
shot 01-hub-drive-gone
expect text "LIBRARY, 166 TRACKS"
expect notext "SANDISK is not connected. Its 12 tracks are hidden and come back when you plug it in."
expect text "Artists"
tap "Artists"
wait 700
shot 02-artists-without-the-drive
expect notext "Stick artist"
key esc
wait 400
key m
wait 500
tap "Library"
wait 700
tap "Music folders"
wait 700
shot 03-folders-without-the-drive
expect text "MUSIC FOLDERS, 2"
expect notext "SANDISK (USB drive)"
expect notext "not connected"
key esc
wait 300
key esc
wait 300
expect text "Playback"
