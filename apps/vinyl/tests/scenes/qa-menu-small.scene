title Vinyl P2a: the Menu walk of qa-menu at 480x320 (the Menu key the seventh transport key) and 320x480 (the Menu icon key at the left of the bottom row; no title in the band), their real density
sizes 480x320 320x480
ppmm 630
# the 3.5-inch panel's 6.3 px/mm: ROW 44, the approved 480x320 layout's volume group and seek row 43 px (the owner's rule R-4)
allow-small
env VINYL_DEMO 1
env VINYL_DEMO_STATE playing

wait 1200
shot 01-now
expect esc
@480x320 expect text "Vinyl"
@320x480 expect notext "Vinyl"
expect text "Evolve 65"
# the Menu key by touch: the seventh transport key (480x320), the icon key at the left of the bottom row (320x480)
@480x320 tapxy 0.910 0.884
@320x480 tapxy 0.150 0.929
wait 400
shot 02-menu
expect text "TOOLS"
expect text "SETTINGS"
expect text "Sleep timer"
expect text "Playback"
expect text "Output"
expect text "Keys"
expect text "About"
expect notext "Equalizer"
expect notext "Library"
# 9's code is LVGL's Enter: its echo must not open the selected row
key 9
wait 300
expect text "TOOLS"
tap "Sleep timer"
wait 400
shot 03-sleep
expect text "STOP PLAYING AFTER"
expect text "This album or queue"
# a choice closes the page (owner-approved): the Menu shows the time left
tap "30 minutes"
wait 400
shot 04-menu-timer
expect text "TOOLS"
expect notext "STOP PLAYING AFTER"
# T opens the Sleep timer page (its code is LVGL's Left: the echo must not go straight back)
key t
wait 400
shot 05-sleep-by-t
expect text "STOP PLAYING AFTER"
# Esc on a Menu page goes back one level, never quits
key esc
wait 400
expect text "TOOLS"
expect noquit
tap "Playback"
wait 400
shot 06-playback
expect text "Gapless"
expect text "Remember position in long files"
expect notext "Speed (later)"
expect notext "Off"
expect text "ReplayGain evens out the loudness between tracks."
# R toggles repeat; its code is LVGL's Right: the echo must not toggle the selected Gapless row
key r
wait 300
expect notext "Off"
expect text "Gapless"
tap "ReplayGain"
wait 400
shot 07-replaygain
expect text "Track"
expect text "Album"
# a choice closes the pick list: Playback shows the new value
tap "Album"
wait 400
shot 08-playback-album
expect text "Album"
expect text "Remember position in long files"
tap "Gapless"
wait 400
shot 09-playback-changed
expect text "Album"
key left
wait 400
tap "Output"
wait 400
expect text "Automatic"
key left
wait 400
expect text "Playback"
tap "Keys"
wait 400
shot 10-keys
expect text "Play or pause"
expect text "Queue, Browse, Output, Menu"
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
wait 300
shot 11-keys-scrolled
key esc
wait 400
expect text "TOOLS"
expect noquit
tap "About"
wait 400
shot 12-about
expect text "FORMATS"
expect text "THIS OUTPUT"
expect text "LIBRARIES"
key left
wait 400
key left
wait 400
expect text "Evolve 65"
key esc
wait 300
expect text "MUSIC / PHOENIX"
expect noquit
