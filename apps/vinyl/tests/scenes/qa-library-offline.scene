title Vinyl P2b: a USB drive that is not connected (its tracks hidden, the note on the hub, the entry kept in Music folders)
sizes 800x480 480x480 720x720 480x800 480x640
env VINYL_DEMO 1
env VINYL_DEMO_LIBRARY offline
env VINYL_DEMO_STATE playing
env VINYL_DEMO_PAGE library
keyboards 1
wait 1200
shot 01-hub-drive-offline
expect text "LIBRARY, 166 TRACKS"
expect text "SANDISK is not connected. Its 12 tracks are hidden and come back when you plug it in."
expect text "Artists"
tap "Artists"
wait 700
shot 02-artists-without-the-drive
expect notext "Stick artist"
key esc
wait 400
key m
wait 500
tap "Library"
wait 700
tap "Music folders"
wait 700
shot 03-folders-offline
expect text "MUSIC FOLDERS, 3"
expect text "SANDISK (USB drive)"
expect text "not connected"
key esc
wait 300
key esc
wait 300
expect text "Playback"
