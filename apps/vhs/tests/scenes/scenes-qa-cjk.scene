# VHS M4: foreign files with Chinese, Japanese and Korean names copied into the folder: listed with their
# names (a foreign name cannot be renamed), oldest at the bottom.
title VHS M4 Scenes with CJK file names (qa-cjk)
sizes 800x480 480x480 720x720 480x800 480x640 640x480
env VHS_FAKE 1
env VHS_SOC bcm2837
# RGB565 as on the 16-bit panels; the harness's own display is 32-bit
env VHS_FORMAT rgb565
env VHS_CLOCK_SYNCED 0
env VHS_DEMO_SCENES cjk

wait 3500
tap "Scenes"
wait 3000
shot 01-cjk-top
expect text "SCENES, 18"
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
wait 400
shot 02-cjk-bottom
expect text "東京の夜"
expect text "家族旅行 2026"
key up
key up
wait 300
shot 03-cjk-more
expect text "회의 녹화"
key esc
wait 1500
key esc
expect quit
