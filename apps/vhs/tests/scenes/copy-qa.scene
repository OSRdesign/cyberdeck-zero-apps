# VHS M6: the drive list and the copy dialog in the undrawn classes (brief 12.2): SANDISK mounted by the system and
# a second drive not mounted (VHS_FAKE_DRIVES mounted): the list, then the copy to SANDISK at once (no mount).
title VHS M6 the copy dialog in the undrawn classes
sizes 800x480 480x480 720x720 480x800 480x640 640x480
env VHS_FAKE 1
env VHS_SOC bcm2837
# RGB565 as on the 16-bit panels; the harness's own display is 32-bit
env VHS_FORMAT rgb565
env VHS_CLOCK_SYNCED 0
env VHS_DEMO_SCENES 1
env VHS_FAKE_DRIVES mounted
env VHS_FAKE_COPY_KBPS 1500

wait 3500
tap "Scenes"
wait 3000
key u
wait 700
shot 01-drive-list
expect text "Copy to which drive?"
expect text "SANDISK"
expect text "not mounted"
tap "SANDISK"
wait 1500
shot 02-copying
expect text "Copying to SANDISK"
expect text "Cancel"
key enter
wait 900
expect notext "Copying to SANDISK"
key esc
wait 1800
key esc
expect quit
