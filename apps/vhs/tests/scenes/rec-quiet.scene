# VHS M3: the camera microphone hears about -90 dBFS (not digital silence): the Sound-on lamp is not lit
# (hidden while off: provisional), no silence toast.
title VHS M3 recording in a quiet room: the lamp stays off
sizes 480x320
ppmm 608
env VHS_FAKE 1
env VHS_SOC bcm2837
# RGB565 as on the 16-bit panels; the harness's own display is 32-bit
env VHS_FORMAT rgb565
env VHS_CLOCK_SYNCED 0
env VHS_FAKE_MIC quiet

wait 1500
key r
wait 2500
shot 01-quiet
expect text "Photo now"
expect notext "Sound on"
expect text "MJPEG 720p with the camera microphone. Stop with R, Space or the red button; it asks nothing and saves the scene."
key r
wait 1200
key esc
expect quit
