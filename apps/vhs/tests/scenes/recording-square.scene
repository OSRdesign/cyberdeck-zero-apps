# VHS M3: a scene recorded with R (canvas Recording-480x320): the 1080p preview switches to the 1280x720
# Video size (held while recording), the REC tag with its timer in the chip's place, Sound on (the fake
# CM969 plays a -20 dBFS tone), the red shutter, Photo now (one photo of the recording's frame), Scenes and
# Settings dimmed, size and time left, the canvas's note; R stops it (nothing asked); then in Video mode
# Space starts and stops one.
title VHS M3 recording in the Square class (720x720, 640x640, 480x480): REC tag, Sound on at the top right, Photo now 270x120, Stop
sizes 720x720 640x640 480x480
ppmm 668
env VHS_FAKE 1
env VHS_SOC bcm2837
# RGB565 as on the 16-bit panels; the harness's own display is 32-bit
env VHS_FORMAT rgb565
env VHS_CLOCK_SYNCED 0
env VHS_FAKE_MIC tone

wait 1500
shot 01-live
expect text "1920x1080  30 fps"
key r
wait 2500
shot 02-recording
expect esc
expect text "Photo now"
expect text "Sound on"
expect text "Scenes"
expect text "Settings"
expect notext "1920x1080  30 fps"
expect notext "Video"
tap "Photo now"
wait 1000
shot 03-photo-now
expect text "Photo now"
key r
wait 1500
shot 04-stopped
expect text "Video"
expect text "1920x1080  30 fps"
expect notext "Photo now"
expect notext "Sound on"
key tab
wait 300
key space
wait 2200
shot 05-recording-video-mode
expect text "Photo now"
key space
wait 1500
shot 06-stopped-video-mode
expect text "Video"
expect text "Photo"
key esc
expect quit
