# VHS M1: the seven toasts of the canvas board Notices-480x320 in the Capture page's toast place (the mode
# word and the note: Cassette's notice replaces the info strip), one per N (VHS_DEMO_NOTICES, scenes only);
# the fifth is red. The last three belong to recording (M3) and playback (milestone 5): drawn here for the review.
title VHS notices in the Square class (720x720, 640x640, 480x480)
sizes 720x720 640x640 480x480
ppmm 668
env VHS_FAKE 1
env VHS_SOC bcm2837
# RGB565 as on the 16-bit panels; the harness's own display is 32-bit
env VHS_FORMAT rgb565
env VHS_DEMO_NOTICES 1

wait 1200
key n
wait 300
shot 01-toast
expect text "Camera unplugged."
key n
wait 300
shot 02-toast
expect text "Camera busy: another program uses it."
key n
wait 300
shot 03-toast
expect text "No access to the camera: add your user to the video group."
key n
wait 300
shot 04-toast
expect text "Power too weak for the camera."
key n
wait 300
shot 05-toast
expect text "Disk almost full: recording stopped."
key n
wait 300
shot 06-toast
expect text "No sound from the camera microphone."
key n
wait 300
shot 07-toast
expect text "This board drops frames at this size."
key esc
expect quit
