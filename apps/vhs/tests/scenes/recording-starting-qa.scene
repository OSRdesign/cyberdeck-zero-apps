# VHS M4 item 1 (the owner's camcorder idea): from REC until the first frame is written the REC tag's red dot
# blinks (500 ms on / off), the tag reads REC 00:00:00, Sound on is hidden, Photo now dimmed; then the dot is
# solid and the timer runs. The fake camera's first frame comes 1.5 s after each STREAMON (VHS_FAKE_START_MS,
# a board camera's slow start). R during the start cancels it: nothing written, so no file, no row, no toast.
title VHS M4 REC start indicator in the undrawn classes
sizes 800x480 480x480 720x720 480x800 480x640 640x480
env VHS_FAKE 1
env VHS_SOC bcm2837
# RGB565 as on the 16-bit panels; the harness's own display is 32-bit
env VHS_FORMAT rgb565
env VHS_CLOCK_SYNCED 0
env VHS_FAKE_MIC tone
env VHS_FAKE_START_MS 1500

wait 3500
shot 01-live
key r
wait 200
shot 02-starting-dot-lit
expect text "REC 00:00:00"
expect notext "Sound on"
expect text "Photo now"
wait 500
shot 03-starting-dot-dark
expect text "REC 00:00:00"
wait 3000
shot 04-recording-solid
expect notext "REC 00:00:00"
expect text "Sound on"
key r
wait 3000
key r
wait 300
shot 05-starting-again
expect text "REC 00:00:00"
key r
wait 3000
shot 06-cancelled
@800x480,480x800,480x640,640x480 expect text "Photo | Video"
@480x480,720x720 expect text "Video"
expect notext "Photo now"
tap "Scenes"
wait 2500
shot 07-one-scene
@800x480,480x800,480x640,640x480 expect text "SCENES, 1"
@480x480,720x720 expect text "1 scene"
key esc
wait 2000
key esc
expect quit
