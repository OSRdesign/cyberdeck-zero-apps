# VHS M1: the user is not in the video group (EACCES at open).
title VHS M1 without access to the camera (the undrawn classes): the standing toast
sizes 800x480 480x480 720x720 480x800 480x640 640x480
env VHS_FAKE 1
env VHS_SOC bcm2837
# RGB565 as on the 16-bit panels; the harness's own display is 32-bit
env VHS_FORMAT rgb565
env VHS_FAKE_SCRIPT noaccess@0

wait 1200
shot 01-noaccess
expect esc
expect text "No access to the camera: add your user to the video group."
expect notext "No camera found"
key esc
expect quit
