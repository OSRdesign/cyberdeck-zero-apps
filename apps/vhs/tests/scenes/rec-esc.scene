# VHS M3: brief 12.4 item 1 (provisional): Esc at the root during a recording finishes the scene (trailer,
# journal closed: the log says "finished"), then VHS quits as Cassette does.
title VHS M3: Esc while recording finishes the scene, then quits
sizes 480x320
ppmm 608
env VHS_FAKE 1
env VHS_SOC bcm2837
# RGB565 as on the 16-bit panels; the harness's own display is 32-bit
env VHS_FORMAT rgb565
env VHS_CLOCK_SYNCED 0
env VHS_FAKE_MIC tone

wait 1500
key r
wait 2000
expect text "Photo now"
key esc
expect quit
