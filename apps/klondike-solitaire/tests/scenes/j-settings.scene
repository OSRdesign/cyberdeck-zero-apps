title Klondike: Settings changed and kept (draw 3, left-handed, four colours, burgundy..., animation off), the deal replayed with them
sizes 640x480 800x480 720x720 1280x800 480x800 800x1280 480x640

env KLONDIKE_TEST_RESET 1
env KLONDIKE_TEST_DEAL 1
env KLONDIKE_TEST_PROBES 1
env KLONDIKE_TEST_DATA persist
wait 300
key m
wait 200
key down
key down
key down
key down
key down
key down
key down
key enter
wait 200
key enter
expect text "3 cards"
key down
key down
key down
key down
key down
key down
key down
key enter
key down
key enter
key down
key enter
key down
key enter
key down
key enter
key enter
wait 200
shot changed
check changed
expect text "Off"
key esc
key esc
wait 400
expect text "New rules are in force for this deal"
shot applied
tap "@T3.top"
tap "@T5.top"
wait 500
expect text "Moves 3"
shot played
check played
expect noquit
