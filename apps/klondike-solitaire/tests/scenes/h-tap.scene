title Klondike: tap to select (highlight) then tap the destination, the stock, double tap to the foundation
sizes 640x480 800x480 720x720 1280x800 480x800 800x1280 480x640
env KLONDIKE_TEST_DATA h-tap
env KLONDIKE_TEST_RESET 1
env KLONDIKE_TEST_DEAL 1
env KLONDIKE_TEST_PROBES 1
wait 300
tap "@T3.top"
wait 100
shot selected
tap "@T5.top"
wait 400
expect text "Moves 3"
shot moved
tap "@S"
wait 400
expect text "Moves 4"
shot drawn
tap "@W"
wait 100
shot waste-selected
tap "@W"
wait 100
shot deselected
check deselected
