title Klondike: a card dragged onto a legal column snaps there; a drop on nothing flies back; undo, redo
sizes 640x480 800x480 720x720 1280x800 480x800 800x1280 480x640
env KLONDIKE_TEST_DATA g-drag
env KLONDIKE_TEST_RESET 1
env KLONDIKE_TEST_DEAL 1
env KLONDIKE_TEST_PROBES 1
wait 300
shot start
@640x480 drag 0.2958 0.5407 0.5305 0.5825
@800x480 drag 0.3210 0.5376 0.5638 0.5793
@720x720 drag 0.3581 0.4458 0.6419 0.4819
@1280x800 drag 0.3233 0.5050 0.5907 0.5501
@480x800 drag 0.3601 0.3217 0.6399 0.3467
@800x1280 drag 0.3605 0.2885 0.6408 0.3135
@480x640 drag 0.3601 0.3991 0.6399 0.4304
wait 300
shot dropped
expect text "Moves 3"
expect text "Score 30"
tap "Undo"
wait 400
expect text "Score 0"
expect text "Moves 4"
@640x480 drag 0.2958 0.5407 0.02 0.2
@800x480 drag 0.3210 0.5376 0.02 0.2
@720x720 drag 0.3581 0.4458 0.02 0.2
@1280x800 drag 0.3233 0.5050 0.02 0.2
@480x800 drag 0.3601 0.3217 0.02 0.2
@800x1280 drag 0.3605 0.2885 0.02 0.2
@480x640 drag 0.3601 0.3991 0.02 0.2
wait 300
shot returned
expect text "Moves 4"
check returned
