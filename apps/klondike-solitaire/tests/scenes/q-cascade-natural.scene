title Klondike: the reduced cascade runs to its end, the last picture stays behind the result box until Close
sizes 640x480 480x800
env KLONDIKE_TEST_DATA q-cascade-natural
env KLONDIKE_TEST_RESET 1
env KLONDIKE_TEST_PROBES 1
env KLONDIKE_TEST_RULES draw=1,passes=0,scoring=standard,timed=0,auto=1,fback=1,fill=king
env KLONDIKE_TEST_BOARD "f C13 D13 H13 S12;t KS;t;t;t;t;t;t;w;s;r 0"
env KLONDIKE_TEST_PREFS anim=1
wait 300
tap "@T1.top"
tap "@T1.top"
wait 900
wait 10500
expect text "You won!"
shot end-with-dialog
check end-with-dialog
tap "Close"
wait 400
shot closed
check closed
