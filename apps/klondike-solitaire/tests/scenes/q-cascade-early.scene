title Klondike: win cascade, just started: the first kings in flight (step 45)
sizes 640x480 480x800 800x1280 1280x800
env KLONDIKE_TEST_DATA q-cascade-early
env KLONDIKE_TEST_RESET 1
env KLONDIKE_TEST_PROBES 1
env KLONDIKE_TEST_RULES draw=1,passes=0,scoring=standard,timed=0,auto=1,fback=1,fill=king
env KLONDIKE_TEST_BOARD "f C13 D13 H13 S12;t KS;t;t;t;t;t;t;w;s;r 0"
env KLONDIKE_TEST_WINFRAME 45
wait 300
tap "@T1.top"
tap "@T1.top"
wait 900
shot cascade
check cascade
expect noquit
