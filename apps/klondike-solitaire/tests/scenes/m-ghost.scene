title Klondike: the lifted run mid-drag (ghost with a shadow)
sizes 640x480 800x480 720x720 1280x800 480x800 800x1280 480x640
env KLONDIKE_TEST_DATA m-ghost
env KLONDIKE_TEST_RESET 1
env KLONDIKE_TEST_DEAL 1
env KLONDIKE_TEST_PROBES 1
env KLONDIKE_TEST_GHOST 8,2,90,40
wait 300
shot ghost
check ghost
