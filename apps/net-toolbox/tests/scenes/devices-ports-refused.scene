# Local devices, a port scan refused
title Net Toolbox: Local devices, a port scan refused
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO "devices=done,ports=refused"
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 250
key enter
wait 300
key down
wait 100
key enter
wait 300
key down
key down
key enter
wait 300
shot refused
expect text "Only devices on your own network can be scanned."
expect notext "Message cut off"
