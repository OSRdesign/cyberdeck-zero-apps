# Local devices, no open port in 1-1024
title Net Toolbox: Local devices, no open port in 1-1024
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO "devices=done,ports=empty"
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 250
key enter
wait 300
key down
wait 100
key down
wait 100
key enter
wait 300
key down
key down
key down
key enter
wait 300
shot done
expect text "Done: no open port among 1024"
expect text "No open port found in ports 1-1024"
expect notext "Message cut off"
