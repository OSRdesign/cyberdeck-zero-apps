# HTTP check, 301 moved (not followed)
title Net Toolbox: HTTP check, 301 moved (not followed)
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO http=moved,http_url=http://example.com
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key enter
key enter
shot result
expect text "301 moved"
expect notext "Message cut off"
