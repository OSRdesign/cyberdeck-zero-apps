# Wi-Fi networks, the Channels view
title Net Toolbox: Wi-Fi networks, the Channels view
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO wifi=list
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 400
key enter
wait 300
shot channels
expect text "Channels"
expect text "Least crowded: channel 13 (2.4 GHz), channel 40 (5 GHz)"
expect text "2.4 GHz"
expect text "Busiest: channel 6, 2 networks"
key down
key down
wait 200
shot middle
key end
wait 300
shot bottom
expect text "Bars show how busy each channel is, neighbouring ones included."
expect text "Channels 149 to 165 are not allowed for Wi-Fi in every country."
expect notext "Message cut off"
