# Wi-Fi networks, the chosen network is not Wi-Fi
title Net Toolbox: Wi-Fi networks, the chosen network is not Wi-Fi
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO "wifi=list,interface=end0"
env NET_TOOLBOX_FIXTURE eth-wifi
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 400
shot noadapter
expect text "No Wi-Fi adapter on end0: choose wlan0 under Network"
expect text "No Wi-Fi adapter on end0"
expect text "Choose a Wi-Fi adapter under Network on the first page."
expect notext "Message cut off"
