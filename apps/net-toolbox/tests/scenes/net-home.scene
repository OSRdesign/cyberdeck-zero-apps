# 0.3: the first row of Home is the chosen network; Automatic shows the system's main interface in brackets.
title Net Toolbox: Home with the Network row, Automatic
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy
env NET_TOOLBOX_FIXTURE pi-3a-plus-dongle
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
shot home
expect text "Network"
expect text "Automatic (wlan0)"
expect text "wlan0: 192.168.68.170"
expect notext "via wlan"
