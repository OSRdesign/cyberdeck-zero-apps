title Net Toolbox: Wake-on-LAN, editing the MAC address
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO wol=awake,wol_machines=3
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
key down
key enter
key down
key down
key enter
shot field
expect text "MAC"
type zz
key enter
shot refused
