title Net Toolbox: Port check, a preset with several ports
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy,port_preset=Mail,port=25
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key enter
key enter
shot mixed
expect text "Mixed"
