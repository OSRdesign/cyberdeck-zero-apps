# The name field with the on-screen keyboard (no physical keyboard); Enter keeps the name.
title Net Toolbox: DNS lookup, typing the name
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key enter
key down
key down
key enter
shot field
expect osk on
key enter
shot back
