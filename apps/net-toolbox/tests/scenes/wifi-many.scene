# Wi-Fi networks, a long list
title Net Toolbox: Wi-Fi networks, a long list
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO wifi=many
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 400
shot list
expect text "25 networks on wlan0, scanned 3 s ago"
key down
key end
wait 300
shot bottom
expect notext "Message cut off"
