# Local devices, stopped in the middle
title Net Toolbox: Local devices, stopped in the middle
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO devices=scan
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 250
key enter
wait 300
expect text "Stop"
key enter
wait 300
shot stopped
expect text "Stopped: 11 devices on 192.168.68.0/24"
expect text "Rescan"
key enter
wait 300
shot again
expect text "Stop"
expect notext "Message cut off"
