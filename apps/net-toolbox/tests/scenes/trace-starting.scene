# Traceroute, just started: two hops
title Net Toolbox: Traceroute, just started: two hops
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO trace=starting,trace_target=example.com
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key enter
key enter
shot running
expect text "to example.com 93.184.215.14, round 1, 2 hops"
expect notext "Message cut off"
