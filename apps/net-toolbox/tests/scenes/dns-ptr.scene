title Net Toolbox: DNS lookup, PTR of an address
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy,dns_type=PTR,dns_name=1.1.1.1,dns_resolver=9.9.9.9
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key enter
key enter
shot ptr
expect text "one.one.one.one"
