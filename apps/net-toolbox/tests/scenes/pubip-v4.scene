# Public IP, IPv4 only (none is normal)
title Net Toolbox: Public IP, IPv4 only (none is normal)
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO pubip=v4
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key enter
shot result
expect text "none"
expect notext "Message cut off"
