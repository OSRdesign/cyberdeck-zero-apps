title Net Toolbox: Speed test, upload
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO speed=up
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key enter
key enter
wait 450
shot upload
expect text "Uploading, 3 s of 8 s"
expect text "Upload"
expect text "Stop"
expect notext "Message cut off"
