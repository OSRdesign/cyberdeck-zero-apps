# Wi-Fi walk test, a long walk (the last 2.5 minutes)
title Net Toolbox: Wi-Fi walk test, a long walk (the last 2.5 minutes)
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO walk=long
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 300
key enter
wait 400
shot running
expect text "Walking: 03:20, weakest -83 dBm"
expect text "Time 03:20"
expect notext "Message cut off"
key enter
wait 400
shot stopped
expect text "Stopped: 03:20, weakest -83 dBm"
key down
key end
wait 300
shot bottom
