title Net Toolbox: Speed test, the latency phase
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO speed=latency
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key enter
key enter
wait 450
shot latency
expect text "Measuring latency"
expect text "Latency"
expect text "Stop"
expect text "Uses up to about 150 MB each way. Start it yourself; on a phone hotspot that is mobile data."
expect notext "Message cut off"
