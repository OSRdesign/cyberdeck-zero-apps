# Local devices, this device's page
title Net Toolbox: Local devices, this device's page
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO devices=done
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 250
key enter
wait 300
key down
wait 100
key end
wait 200
key up
key up
wait 100
key enter
wait 300
key home
wait 200
shot detail
expect text "cyberdeck"
expect text "This device"
expect text "192.168.68.121"
expect notext "Message cut off"
