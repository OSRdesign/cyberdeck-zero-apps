# Save log before anything ran says so (the band), nothing is written.
title Net Toolbox: Save log with nothing to save
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key enter
key down
key down
key down
key down
key down
key enter
shot nothing
expect text "Nothing to save yet: run it first"
