title Net Toolbox: Bluetooth radar, before the first scan
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO ble=scan25
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
shot idle
expect text "Press Start to scan for Bluetooth devices"
expect text "Wi-Fi and Bluetooth share one radio: a Bluetooth keyboard may stutter while scanning."
expect text "Press Start to listen for Bluetooth devices around you. The scan lasts up to a minute and stops by itself. Nothing is connected or paired."
expect text "near"
expect text "far"
expect text "Start"
expect notext "Message cut off"
