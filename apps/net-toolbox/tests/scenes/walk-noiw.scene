# Wi-Fi walk test, iw is missing
title Net Toolbox: Wi-Fi walk test, iw is missing
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO walk=noiw
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 300
key enter
wait 400
shot running
expect text "Dashed line: -75 dBm. Squares: weak. Access point changes need iw."
key enter
wait 400
key down
key end
wait 300
shot bottom
expect text "not known: iw is missing"
expect notext "Message cut off"
