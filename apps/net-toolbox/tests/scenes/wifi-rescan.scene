# Wi-Fi networks, Rescan gives the next list
title Net Toolbox: Wi-Fi networks, Rescan gives the next list
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO wifi=vanish
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 400
key right
key enter
wait 300
shot rescanned
expect notext "CafeGuest"
expect text "10 networks on wlan0, scanned 3 s ago"
expect notext "Message cut off"
