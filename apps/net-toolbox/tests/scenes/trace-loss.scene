# Traceroute, real loss up to the end
title Net Toolbox: Traceroute, real loss up to the end
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO trace=loss,trace_target=example.com
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key enter
key enter
shot running
key down
key end
shot end
expect text "43 %"
key tab
key enter
shot stopped
expect text "Reached in 9 hops, 168 ms"
expect notext "Message cut off"
