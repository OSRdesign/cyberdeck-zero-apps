# HTTP check, certificate for another name
title Net Toolbox: HTTP check, certificate for another name
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO http=cert-mismatch,http_url=https://wrong.host.badssl.com
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key enter
key enter
shot result
expect text "Certificate name mismatch"
expect notext "Message cut off"
