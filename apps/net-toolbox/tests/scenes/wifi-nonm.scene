# Wi-Fi networks, nmcli is missing
title Net Toolbox: Wi-Fi networks, nmcli is missing
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO wifi=nonm
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 400
shot nonm
expect text "nmcli is missing: the scan needs NetworkManager"
expect text "Install the package network-manager."
expect notext "Message cut off"
