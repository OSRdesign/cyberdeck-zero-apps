# Traceroute, finding the name, and a name that does not exist
title Net Toolbox: Traceroute, finding the name, and a name that does not exist
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO trace=resolving,trace_target=example.com
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key enter
key enter
shot finding
expect text "Finding example.com..."
expect text "Waiting for the first hop to answer."
expect notext "Message cut off"
