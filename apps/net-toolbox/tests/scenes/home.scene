# Home on the deck: the band, the nine tools (the list scrolls), Esc at Home ends the app.
title Net Toolbox: Home
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
shot home
expect text "›"
expect text "Net Toolbox"
expect text "Diagnose my connection"
expect text "wlan0: 192.168.68.121"
key down
key down
shot third-row
key end
wait 400
shot last-row
expect text "Interfaces"
key home
wait 400
expect noquit
key esc
expect quit
