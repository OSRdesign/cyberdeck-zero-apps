# HTTP check, the address, the method and the switch
title Net Toolbox: HTTP check, the address, the method and the switch
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO http=ok
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key enter
key down
key enter
shot field
expect osk on
type example.org
key enter
shot typed
key down
key enter
shot methods
expect text "HEAD"
key down
key enter
key down
key enter
shot insecure-on
expect text "On"
key enter
shot insecure-off
key down
key enter
shot saved-nothing
expect text "Nothing to save yet: run it first"
