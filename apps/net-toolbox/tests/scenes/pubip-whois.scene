# Public IP, then Whois of this address
title Net Toolbox: Public IP, then Whois of this address
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO pubip=both,whois=arin
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key enter
key end
shot actions
key up
key enter
shot whois
expect text "Net name"
expect text "GOGL"
key esc
expect text "Public IPv4"
key end
key enter
shot saved
expect notext "Message cut off"
