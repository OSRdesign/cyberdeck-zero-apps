# Local devices, Ping this device
title Net Toolbox: Local devices, Ping this device
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO "devices=done,ping=mixed"
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 250
key enter
wait 300
key down
wait 100
key enter
wait 300
key enter
wait 400
shot ping
expect text "Stop"
expect text "192.168.68.1"
expect text "Target"
key esc
wait 300
expect text "Ping this device"
expect noquit
expect notext "Message cut off"
