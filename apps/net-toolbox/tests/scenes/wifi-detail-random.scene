# Wi-Fi networks, a hotspot with a private address
title Net Toolbox: Wi-Fi networks, a hotspot with a private address
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO wifi=list
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 400
key down
key down
key down
key down
key down
wait 100
key enter
wait 300
shot detail
expect text "Private (random) address: the vendor cannot be known"
expect notext "Message cut off"
