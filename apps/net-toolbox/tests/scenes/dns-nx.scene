title Net Toolbox: DNS lookup, no such name
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy,dns_name=nx.example.com
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key enter
key enter
shot nxdomain
expect text "No such name (NXDOMAIN), 12 ms, via 192.168.1.1"
