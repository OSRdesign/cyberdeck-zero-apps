title Net Toolbox: Speed test, an error (e-refused)
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO speed=e-refused
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key enter
key enter
wait 450
shot error
expect text "Cloudflare refused the request (HTTP 403)."
expect text "Start"
expect notext "Message cut off"
