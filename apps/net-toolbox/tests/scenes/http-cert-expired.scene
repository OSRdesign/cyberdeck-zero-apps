# HTTP check, expired certificate
title Net Toolbox: HTTP check, expired certificate
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO http=cert-expired,http_url=https://expired.badssl.com
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key enter
key enter
shot result
expect text "Certificate expired"
expect text "expired 12 days ago"
expect notext "Message cut off"
