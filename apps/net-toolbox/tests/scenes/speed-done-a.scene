# Results card: the list scrolled to it when the run ended (the grade card is on screen); End shows the bottom (the last row, Server).
title Net Toolbox: Speed test, results, grade A
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO speed=done-a
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key enter
key enter
wait 450
shot result
expect text "Download"
expect text "Upload"
expect text "A: latency stays flat under load"
expect text "Bufferbloat grade"
expect text "Start"
expect notext "Message cut off"
key down
key down
key down
key down
key down
wait 300
shot middle
expect text "Latency while downloading"
key end
wait 300
shot bottom
expect text "Server"
expect notext "Message cut off"
