# Results card: the list scrolled to it when the run ended; End shows the bottom.
title Net Toolbox: Speed test, results without a grade
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO speed=done-noping
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key enter
key enter
wait 450
shot result
expect text "Download"
expect text "Upload"
expect text "Start"
expect notext "Message cut off"
key down
key down
key down
key down
key down
wait 300
shot middle
expect text "Latency while downloading"
expect text "Server"
key end
wait 300
shot bottom
expect text "Not measured: No ping target: the latency under load is not measured"
expect text "Bufferbloat grade"
expect notext "Message cut off"
