# Traceroute by touch
title Net Toolbox: Traceroute by touch
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO trace=healthy,trace_target=example.com
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
tap "Traceroute"
tap "Traceroute"
tap "Start"
shot running
expect text "Stop"
tapxy 0.5 0.62
wait 400
tapxy 0.5 0.62
shot details
tap "Stop"
shot stopped
expect text "Reached in 9 hops, 43 ms"
tap "Save log"
shot saved
tap "Target"
shot choices
tap "Esc"
tap "Esc"
tap "Esc"
