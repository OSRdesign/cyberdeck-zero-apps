title Net Toolbox: Bluetooth radar, no bluetooth adapter
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO ble=none
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
key enter
wait 300
shot problem
expect text "No Bluetooth adapter"
expect text "Use a board with Bluetooth, or plug in a USB Bluetooth adapter"
expect text "Start"
expect notext "Message cut off"
