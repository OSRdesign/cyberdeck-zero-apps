# Traceroute, a healthy path of 9 hops
title Net Toolbox: Traceroute, a healthy path of 9 hops
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO trace=healthy,trace_target=example.com
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key enter
shot idle
expect text "Press Start to trace example.com"
key enter
shot running
expect text "to example.com 93.184.215.14, round 14, 9 hops"
expect text "Stop"
expect notext "Message cut off"
key down
key down
shot selected
key enter
shot details
expect text "Fine: it answers every probe."
key enter
key end
shot last-hop
key tab
key enter
shot stopped
expect text "Reached in 9 hops, 43 ms"
expect text "Start"
expect notext "Message cut off"
