title Net Toolbox: Bluetooth radar, bluetooth is switched off
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO ble=off
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
key enter
wait 300
shot problem
expect text "Bluetooth is switched off"
expect text "Turn Bluetooth on in Settings > Bluetooth"
expect text "Start"
expect notext "Message cut off"
