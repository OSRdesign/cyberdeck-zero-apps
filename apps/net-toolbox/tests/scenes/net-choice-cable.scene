title Net Toolbox: a USB Ethernet adapter whose cable is out
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy
env NET_TOOLBOX_FIXTURE eth-down
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key up
key enter
shot choice
expect text "enx00e04c680a12  no link"
key down
key down
key enter
shot home
expect text "enx00e04c680a12: not connected"
