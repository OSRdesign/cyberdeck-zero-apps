# Wi-Fi walk test, Reset forgets the walk
title Net Toolbox: Wi-Fi walk test, Reset forgets the walk
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO walk=run
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 300
key enter
wait 400
expect text "Time 01:23"
key right
key enter
wait 300
shot reset
expect text "Press Start, then walk around"
expect text "Ready"
expect text "Start"
expect notext "Message cut off"
