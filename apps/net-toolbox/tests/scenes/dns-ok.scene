title Net Toolbox: DNS lookup
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key enter
shot idle
expect text "›"
expect text "Look up"
key enter
shot answer
expect text "93.184.215.14"
expect text "OK (NOERROR), 12 ms, via 192.168.1.1"
