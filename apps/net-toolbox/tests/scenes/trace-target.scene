# Traceroute, choosing the target
title Net Toolbox: Traceroute, choosing the target
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO trace=healthy
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key enter
key right
key enter
shot choices
expect text "1.1.1.1 Cloudflare"
key down
key enter
shot picked
expect text "1.1.1.1"
key right
key enter
key down
key down
key enter
shot field
expect osk on
type nas.local
key enter
shot typed
expect text "nas.local"
key enter
shot started
expect text "to nas.local 93.184.215.14, round 14, 9 hops"
