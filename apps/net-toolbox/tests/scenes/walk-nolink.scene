# Wi-Fi walk test, the link dropped for a while
title Net Toolbox: Wi-Fi walk test, the link dropped for a while
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO walk=nolink
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 300
key enter
wait 400
key enter
wait 400
shot stopped
key down
key end
wait 300
shot bottom
expect text "Without link"
expect text "4 s"
expect notext "Message cut off"
