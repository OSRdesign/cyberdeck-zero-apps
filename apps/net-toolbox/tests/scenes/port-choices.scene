title Net Toolbox: Port check, choosing the port
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO diag=healthy
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key enter
key down
key down
key enter
shot presets
expect text "Custom port..."
key up
key up
key up
key up
key up
key up
key up
key up
key up
key up
key up
key up
shot first
expect text "Web 80, 443"
key enter
shot picked
expect text "Web 80, 443"
key up
key up
key enter
shot result
expect text "Open"
