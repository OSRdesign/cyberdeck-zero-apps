# Wi-Fi walk test, walking
title Net Toolbox: Wi-Fi walk test, walking
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO walk=run
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 300
key enter
wait 400
shot running
expect text "Stop"
expect text "Walking: 01:23, weakest -82 dBm"
expect text "Time 01:23"
expect text "HomeNet on wlan0"
expect text "Dashed line: -75 dBm. Squares: weak. Ticks: access point changes."
expect notext "Message cut off"
