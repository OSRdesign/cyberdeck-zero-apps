# Wi-Fi networks, Wi-Fi switched off
title Net Toolbox: Wi-Fi networks, Wi-Fi switched off
sizes 640x480 800x480 720x720 1024x600 1280x720
env NET_TOOLBOX_DEMO wifi=off
env NET_TOOLBOX_FIXTURE deck
env NET_TOOLBOX_LOG_DIR /tmp/nt-scene-logs
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 400
shot off
expect text "Wi-Fi is switched off"
expect text "Wi-Fi is switched off."
expect text "Turn Wi-Fi on, then try again."
expect notext "Message cut off"
