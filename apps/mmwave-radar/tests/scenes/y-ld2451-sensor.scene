title mmWave Radar: Sensor page with the LD2451 chosen as the Sensor type (the last row, six rows in all)
sizes 480x320 320x480
env MMWAVE_DEMO ld2451-two
env MMWAVE_TEST_CONFIG 1

wait 4000
key 4
wait 700
key down
key down
key down
key down
key down
key down
key enter
key enter
wait 600
shot sensor-ld2451
check sensor-ld2451
expect text "Sensor type"
expect text "LD2451"
expect noquit
