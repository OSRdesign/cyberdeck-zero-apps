title mmWave Radar: Hide held targets on (Sensor page, 5th setting row): the stale T2 is not drawn or listed, the status line says "1 held"
sizes 640x480 480x320 320x480 480x800
env MMWAVE_DEMO held
env MMWAVE_TEST_CONFIG 1

wait 2500
key 4
wait 500
key down
key down
key down
key down
key down
wait 300
expect text "Hide held targets"
key enter
wait 400
expect text "On"
shot held-hide-sensor
check held-hide-sensor
key 1
wait 9000
shot held-hide-radar
check held-hide-radar
expect text "1 held"
key 2
wait 700
shot held-hide-table
check held-hide-table
key 1
wait 300
key 4
wait 300
key enter
wait 300
key 1
wait 1200
expect notext "1 held"
expect noquit
