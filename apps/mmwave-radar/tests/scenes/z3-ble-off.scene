title mmWave Radar: Connection Bluetooth, Bluetooth is off (scripted): the message and nothing else
sizes 480x320 320x480
env MMWAVE_DEMO ble-off
env MMWAVE_TEST_CONFIG 1

wait 1500
shot ble-off
check ble-off
expect text "Bluetooth is off"
expect notext "HLK-LD2451_49F0"
expect notext "TRIED"
expect noquit
