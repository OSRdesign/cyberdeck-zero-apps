title mmWave Radar: Connection Bluetooth, No Bluetooth adapter (scripted): the message and nothing else
sizes 480x320 320x480
env MMWAVE_DEMO ble-noadapter
env MMWAVE_TEST_CONFIG 1

wait 1500
shot ble-noadapter
check ble-noadapter
expect text "No Bluetooth adapter"
expect notext "HLK-LD2451_49F0"
expect notext "TRIED"
expect noquit
