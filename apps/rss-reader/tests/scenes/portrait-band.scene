# PDA S4 (launcher report 044): a launcher with the writing zone runs the app upright with APPLAUNCH_PDA=1 and the user's
# Settings > On-screen keyboard is Handwriting + keyboard (input.state hand=1). Nothing in the app changed: the band shows
# exactly where the on-screen keyboard would (Add a feed's field, the Browse search; touch only), its rows are left free
# through the keyboard's inset, its keys reach the app as the keyboard's do. Keyb brings the standard keyboard, its cross
# the band back. 640x480 (a landscape app on a portrait launcher runs turned): no band, the standard keyboard.
title RSS Reader: the writing zone's band (PDA mode)
env RSSREADER_DATA /tmp/rss-reader-scene-data
band
sizes 480x800 480x640 800x1280 640x480

wait 900
expect text "Favorites"
@480x800,480x640,800x1280 expect band hidden
@640x480 expect band none

# Add a feed: the page asks for a field at once
key down
key down
key down
key enter
wait 600
@480x800,480x640,800x1280 expect band shown
@480x800,480x640,800x1280 expect osk off
@640x480 expect osk on
shot add-band
expect text "Find feed"

# written into the field with the shipped strokes (a landscape size types it)
@480x800,480x640,800x1280 write letters a b c
@640x480 type "abc"
wait 300
expect text "abc"
shot add-written

# Keyb: the standard keyboard with its close cross in the band's place; the cross brings the band back
@480x800,480x640,800x1280 zonekey Keyb
@480x800,480x640,800x1280 wait 400
@480x800,480x640,800x1280 expect osk on
@480x800,480x640,800x1280 expect band hidden
@480x800,480x640,800x1280 shot add-keyb
@480x800,480x640,800x1280 tapkey CLOSE
@480x800,480x640,800x1280 wait 400
@480x800,480x640,800x1280 expect band shown
@480x800,480x640,800x1280 expect osk off

# a keyboard connects: no band, no on-screen keyboard
keyboards 1
wait 1300
expect osk off
@480x800,480x640,800x1280 expect band hidden
shot add-keyboard
keyboards 0
wait 1300
# the first Esc leaves the field (the band goes), the second leaves the page
key esc
wait 600
key esc
wait 600
expect text "Favorites"
