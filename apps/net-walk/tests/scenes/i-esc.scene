title Net Walk: Esc closes a window first, a short Esc on the board ends the app
sizes 480x320 640x480 800x480 1024x600 1280x800 720x720 480x800 480x640 800x1280
env NETWALK_TEST_DATA i-esc
env NETWALK_TEST_RESET 1
env NETWALK_TEST_SEED 7
env NETWALK_TEST_PROBES 1

wait 300
tap "@size"
wait 300
key esc
wait 300
expect text "@mode=play"
expect noquit
key esc
wait 300
expect quit
