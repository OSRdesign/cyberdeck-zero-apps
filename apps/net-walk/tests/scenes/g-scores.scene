title Net Walk: a win is written to the scores; the Scores window lists the best moves and time per size (info rows, grey values)
sizes 480x320 640x480 800x480 1024x600 1280x800 720x720 480x800 480x640 800x1280
env NETWALK_TEST_DATA g-scores
env NETWALK_TEST_RESET 1
env NETWALK_TEST_SEED 7
env NETWALK_TEST_PROBES 1
env NETWALK_TEST_SETUP "almost moves:40 time:97"

wait 300
tap "@scores"
wait 300
expect text "@mode=scores"
shot scores-empty
check scores-empty
tap "@ok"
wait 300
key enter
wait 1500
expect text "@mode=win"
shot win-record
tap "@ok"
wait 300
tap "@scores"
wait 300
shot scores
check scores
key enter
wait 300
expect text "@mode=play"
expect noquit
