title Net Walk: the Size window (Easy 5x5, Normal 7x7, Hard 9x9, Expert 9x9 wrap), the check, the action dots
sizes 480x320 640x480 800x480 1024x600 1280x800 720x720 480x800 480x640 800x1280
env NETWALK_TEST_DATA f-size
env NETWALK_TEST_RESET 1
env NETWALK_TEST_SEED 7
env NETWALK_TEST_PROBES 1

wait 300
tap "@size"
wait 300
expect text "@mode=size"
shot size
check size
tap "@s-hard"
wait 400
expect text "@level=hard"
expect text "@mode=play"
shot hard
check hard
tap "@size"
wait 300
tap "@s-expert"
wait 400
expect text "@level=expert"
shot expert
check expert
tap "@size"
wait 300
tap "@s-easy"
wait 400
expect text "@level=easy"
shot easy
check easy
tap "@size"
wait 300
tap "@cancel"
wait 300
expect text "@mode=play"
expect text "@level=easy"
expect noquit
