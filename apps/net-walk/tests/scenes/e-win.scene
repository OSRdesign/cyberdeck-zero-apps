title Net Walk: the last turn wins: the cables flash, then the Network up! window with the moves and OK
sizes 480x320 640x480 800x480 1024x600 1280x800 720x720 480x800 480x640 800x1280
env NETWALK_TEST_DATA e-win
env NETWALK_TEST_RESET 1
env NETWALK_TEST_SEED 7
env NETWALK_TEST_PROBES 1
env NETWALK_TEST_SETUP "almost moves:40 time:97"

wait 300
shot before-win
check before-win
expect text "@won=0"
key enter
wait 250
expect text "@mode=flash"
shot flash
wait 1300
shot win
check win
expect text "@mode=win"
expect text "@won=1"
expect text "@alllit=1"
expect text "@ok"
tap "@ok"
wait 300
expect text "@mode=play"
expect text "@moves=0"
shot next
expect noquit
