title Net Walk: a tap turns clockwise, a press of 0.35 s counter-clockwise, a hold of 0.6 s toggles the padlock, a locked tile does not turn
sizes 480x320 640x480 800x480 1024x600 1280x800 720x720 480x800 480x640 800x1280
env NETWALK_TEST_DATA b-touch
env NETWALK_TEST_RESET 1
env NETWALK_TEST_SEED 7
env NETWALK_TEST_PROBES 1

wait 300
tap "@t2,2"
wait 200
expect text "@moves=1"
shot tapped
hold "@t3,2" 450
wait 200
expect text "@moves=2"
hold "@t4,1" 800
wait 200
expect text "@locks=1"
expect text "@moves=2"
shot locked
tap "@t4,1"
wait 200
expect text "@moves=2"
hold "@t4,1" 800
wait 200
expect text "@locks=0"
tap "@t4,1"
wait 200
check after
expect text "@moves=3"
expect noquit
