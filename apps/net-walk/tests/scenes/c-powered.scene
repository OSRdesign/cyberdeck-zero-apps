title Net Walk: a game in progress, part of the network energised (green cables, lit monitors), a few padlocks
sizes 480x320 640x480 800x480 1024x600 1280x800 720x720 480x800 480x640 800x1280
env NETWALK_TEST_DATA c-powered
env NETWALK_TEST_RESET 1
env NETWALK_TEST_SEED 7
env NETWALK_TEST_PROBES 1
env NETWALK_TEST_SETUP "power:22 moves:23 time:87 lock:0,10,48"

wait 300
shot powered
check powered
expect text "@moves=23"
expect text "@locks=3"
expect text "@alllit=0"
expect noquit
