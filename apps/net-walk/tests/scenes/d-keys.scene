title Net Walk: arrows move the cursor, Enter and Space turn clockwise, C counter-clockwise, L the padlock, N a new game
sizes 480x320 640x480 800x480 1024x600 1280x800 720x720 480x800 480x640 800x1280
env NETWALK_TEST_DATA d-keys
env NETWALK_TEST_RESET 1
env NETWALK_TEST_SEED 7
env NETWALK_TEST_PROBES 1

wait 300
key right
key down
shot cursor
check cursor
key enter
wait 100
expect text "@moves=1"
key space
wait 100
expect text "@moves=2"
type c
wait 100
expect text "@moves=3"
type l
wait 100
expect text "@locks=1"
key enter
wait 100
expect text "@moves=3"
shot keyed
check keyed
type n
wait 200
expect text "@moves=0"
expect text "@locks=0"
expect noquit
