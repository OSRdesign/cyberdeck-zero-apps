title Cassette Bluetooth (T4, synthetic names): the Input picker on a board without a sound server: the USB cards and the footer "Bluetooth audio is not set up on this board"
sizes 320x480 480x320 480x800 640x480 800x480 480x480 720x720
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_BT notsetup
env CASSETTE_LAYOUT_CHECK 1

wait 500
key s
wait 300
key down
key enter
wait 300
expect text "USB Audio Device"
expect text "USB Headset"
expect text "Bluetooth audio is not set up on this board"
shot input-notsetup
expect notext "LAYOUT FAIL"
key esc
wait 300
key esc
wait 300
expect text "SOFT"
expect noquit
