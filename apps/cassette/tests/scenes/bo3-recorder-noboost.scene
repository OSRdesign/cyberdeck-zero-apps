title Cassette: a card without a Mic boost keeps the CARD stepper with its level, as before
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO recording
env CASSETTE_LAYOUT_CHECK 1

wait 500
expect text "CARD"
expect notext "MIC BOOST"
@480x320,640x480 expect text "+13.0 dB"
@320x480 expect text "+13 dB"
shot card-slot
expect notext "LAYOUT FAIL"
expect noquit
