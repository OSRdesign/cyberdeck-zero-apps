title Cassette notice on the list page (T6d): Name refused: use letters, digits, - and _ replaces the hint line (landscape) or the top strip (narrow); the layout check passes while it shows
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_NOTICE "Name refused: use letters, digits, - and _"
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
expect text "Name refused: use letters, digits, - and _"
shot list-refused
expect notext "LAYOUT FAIL"
expect text "RENAME"
expect noquit
