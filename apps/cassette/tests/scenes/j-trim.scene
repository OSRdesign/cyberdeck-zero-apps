title Cassette: trim and split (board CassetteTrim): Take 006, a 60 s window, IN and OUT outside as edge chips, two splits with the second selected (SPLIT reads REMOVE)
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_PAGE trim
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot trim
expect text "REMOVE"
expect text "ZOOM"
expect text "POSITION"
expect text "SET IN"
expect text "SAVE"
@320x480 expect text "SPLIT 2 SELECTED"
expect notext "LAYOUT FAIL"
expect noquit
