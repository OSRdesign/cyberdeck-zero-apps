title Cassette notice on the settings page (T6d): Name refused: use letters, digits, - and _ replaces the 'more below' line (landscape) or a strip at the bottom of the list (narrow); the layout check passes while it shows
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_NOTICE "Name refused: use letters, digits, - and _"
env CASSETTE_LAYOUT_CHECK 1

wait 500
key s
wait 400
expect text "Name refused: use letters, digits, - and _"
shot settings-refused
expect notext "LAYOUT FAIL"
expect text "Input"
expect noquit
