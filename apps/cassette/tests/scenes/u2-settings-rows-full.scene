title Cassette settings rows (T6d), a card with a mute control and two outputs: Mic mute (card) after Auto gain, Output last; top, middle and scrolled to the bottom
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_SETTINGS full
env CASSETTE_LAYOUT_CHECK 1

wait 400
key s
wait 400
expect text "Input"
expect text "Mic mute (card)"
shot rows-full-top
expect notext "LAYOUT FAIL"
drag 0.5 0.85 0.5 0.5
wait 500
shot rows-full-middle
expect notext "LAYOUT FAIL"
drag 0.5 0.9 0.5 0.05
drag 0.5 0.9 0.5 0.05
drag 0.5 0.9 0.5 0.05
wait 500
expect text "Sync every"
expect text "Folder"
expect text "Auto-split"
expect text "Output"
shot rows-full-bottom
expect notext "LAYOUT FAIL"
key esc
wait 300
expect text "SOFT"
expect noquit
