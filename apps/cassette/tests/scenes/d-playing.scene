title Cassette: playing Take 006 (PLAY latched, both hubs turning counterclockwise, the played level on L and R, PLAY lamp)
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO playing
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot playing
expect text "PLAY"
expect notext "PAUSE"
expect notext "LAYOUT FAIL"
expect noquit
