title Cassette state (PLAY/PAUSE key, hubs, meter): a take paused: PAUSE latched, the hubs still, the played level falling away
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO play-paused
env CASSETTE_ANIM_TICKS 2
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot state-play-paused
@480x320 expect text "PAUSED TAKE 006 · 05:44 / 12:08"
@320x480 expect text "05:44 / 12:08"
expect text "PAUSE"
expect notext "LAYOUT FAIL"
expect noquit
