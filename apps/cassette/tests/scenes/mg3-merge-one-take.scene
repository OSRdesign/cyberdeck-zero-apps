title Cassette MERGE with one take in the list: the key is dimmed and a press says why (Merging needs two takes); merge mode does not open
sizes 320x480 480x320 640x480 480x800 800x480 480x480 720x720
ppmm 608
env CASSETTE_DEMO onetake
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
expect text "MERGE"
key m
wait 300
expect text "Merging needs two takes"
expect text "RENAME"
expect notext "CANCEL"
shot one-take
expect notext "LAYOUT FAIL"
expect noquit
