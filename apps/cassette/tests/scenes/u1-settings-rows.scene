title Cassette settings rows (T6d), a card with no mute control and one output: top, middle and scrolled to the bottom; Sync every, the read-only Channels row, no Mic mute and no Output
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_LAYOUT_CHECK 1

wait 400
key s
wait 400
expect text "Input"
expect text "Input level"
shot rows-top
expect notext "LAYOUT FAIL"
drag 0.5 0.85 0.5 0.5
wait 500
shot rows-middle
expect notext "LAYOUT FAIL"
drag 0.5 0.9 0.5 0.05
drag 0.5 0.9 0.5 0.05
drag 0.5 0.9 0.5 0.05
wait 500
expect text "Sync every"
expect text "Folder"
expect text "Auto-split"
expect notext "Mic mute (card)"
expect notext "Output"
shot rows-bottom
expect notext "LAYOUT FAIL"
key esc
wait 300
expect text "SOFT"
expect noquit
