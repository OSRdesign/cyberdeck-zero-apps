title Cassette notice when a take starts through the sound server (T6e): the card is in use
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO recording
env CASSETTE_DEMO_SERVER 1
env CASSETTE_DEMO_NOTICE "Recording through the sound server: the card is in use"
env CASSETTE_LAYOUT_CHECK 1

wait 600
expect text "Recording through the sound server: the card is in use"
shot server-notice
expect notext "LAYOUT FAIL"
expect text "SOFT"
expect noquit
