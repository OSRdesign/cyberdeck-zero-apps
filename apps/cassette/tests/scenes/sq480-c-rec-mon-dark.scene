title square screen, recording with the MON lamp dark
sizes 480x480
ppmm 667
env CASSETTE_DEMO recording
env CASSETTE_DEMO_MONITOR off
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot recording-mon-dark
expect text "MON"
expect text "WAV 48k"
expect notext "TAKE 007"
expect notext "LAYOUT FAIL"
expect noquit
