title Cassette: recording a mono take, the level in the TARGET zone (board Cassette, option A cream)
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO recording
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot recording
expect esc
expect text "CARD"
expect text "SOFT"
@480x320,640x480 expect text "+13.0 dB"
@320x480 expect text "+13 dB"
expect notext "LAYOUT FAIL"
expect noquit
