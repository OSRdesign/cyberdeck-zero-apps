title Cassette settings, a card with a playback side (live monitor): Monitor and Monitor level after Limiter; the level is dimmed while Monitor is off; Right on the switch turns it on and the level answers to Right (steps of 5 %)
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_MONITOR off
env CASSETTE_LAYOUT_CHECK 1

wait 500
key s
wait 300
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
wait 300
expect text "Monitor"
expect text "Monitor level"
expect text "50 %"
expect text "Limiter"
shot monitor-off-level-dimmed
expect notext "LAYOUT FAIL"
key right
wait 200
say Right on the dimmed level did nothing (no setting_slider)
key up
key right
wait 300
say Right on Monitor turned it on (setting_toggle monitor on)
shot monitor-on
expect notext "LAYOUT FAIL"
key down
key right
key right
wait 300
expect text "60 %"
say two Rights on the level: 50 % to 60 % (setting_slider monitor_level 12)
shot monitor-level-60
expect notext "LAYOUT FAIL"
key esc
wait 300
expect text "SOFT"
expect noquit
