title Cassette: the recordings list shows the format at the end of each row detail line (WAV, FLAC, OPUS) when a folder holds takes of several formats; on a narrow list the line stays one line (size dropped, then the date shortened, the tag kept)
sizes 480x320 640x480 320x480 480x800 480x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_LIST_TAGS 1
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
expect text "Take 007"
expect text "today 14:32 · 42 s · 4 MB · FLAC"
@480x320,640x480,480x480 expect text "today 11:05 · 12 min · 69 MB · WAV"
@480x320,640x480,480x480 expect text "yesterday 18:20 · 3 min · 17 MB · OPUS"
@320x480,480x800 expect text "today 11:05 · 12 min · WAV"
@320x480,480x800 expect text "yesterday 18:20 · 3 min · OPUS"
@320x480,480x800 expect notext "69 MB"
shot list-tags
expect notext "LAYOUT FAIL"
key esc
wait 300
expect noquit
