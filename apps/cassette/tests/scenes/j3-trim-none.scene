title Cassette: trim and split without split points
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_PAGE trim
env CASSETTE_DEMO_TRIM none
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot trim-none
expect text "SPLIT"
expect notext "REMOVE"
@480x320,640x480 expect text "IN 02:58.7 · OUT 10:28.7 · LEN 07:30.0 · no splits"
expect notext "LAYOUT FAIL"
expect noquit
