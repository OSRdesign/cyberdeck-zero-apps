title square screen: Cassette settings with every merged row (r7): Monitor and Monitor level after Limiter, Take number after File prefix; focus on Monitor level, then on Take number, then scrolled to the bottom
sizes 480x480
ppmm 667
env CASSETTE_DEMO idle
env CASSETTE_DEMO_MONITOR on
env CASSETTE_LAYOUT_CHECK 1

wait 500
key s
wait 300
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
wait 300
expect text "Monitor"
expect text "Monitor level"
expect text "50 %"
shot all-rows-monitor
expect notext "LAYOUT FAIL"
key down
key down
key down
key down
wait 300
expect text "Take number"
expect text "Next: 007"
shot all-rows-take-number
expect notext "LAYOUT FAIL"
drag 0.5 0.9 0.5 0.05
drag 0.5 0.9 0.5 0.05
drag 0.5 0.9 0.5 0.05
wait 500
expect text "Take number"
expect text "Auto-split"
shot all-rows-bottom
expect notext "LAYOUT FAIL"
key esc
wait 300
expect text "SOFT"
expect noquit
