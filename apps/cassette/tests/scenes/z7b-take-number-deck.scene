title Cassette (deck, 640x480 at 11.3 px/mm): Take number page, buttons and rows of the toolkit ROW (79 px)
sizes 640x480
ppmm 1130
env CASSETTE_DEMO idle
env CASSETTE_LAYOUT_CHECK 1

wait 500
key s
wait 300
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
wait 300
shot settings-take-number-row
expect text "Take number"
expect text "Next: 007"
expect notext "LAYOUT FAIL"
key right
wait 300
shot take-number-page
expect text "007"
expect text "Reset to 1"
expect text "Set"
expect notext "LAYOUT FAIL"
key down
key down
key right
wait 200
expect text "008"
key down
key right
wait 200
expect text "018"
key down
key right
wait 200
expect text "118"
shot take-number-stepped
expect notext "LAYOUT FAIL"
key left
key up
key left
key up
key left
wait 200
expect text "007"
key esc
wait 300
expect text "Next: 007"
say Esc closed the page and nothing was applied (no setting_number)
tap "Take number"
wait 300
key down
key down
key right
wait 200
expect text "008"
key up
key right
wait 300
expect text "Next: 008"
say Set applied 8 (setting_number takenum 8) and the row shows Next: 008
tap "Take number"
wait 300
key down
key left
wait 300
expect text "001"
shot take-number-reset
expect notext "LAYOUT FAIL"
key enter
wait 300
expect text "Next: 001"
say Reset to 1 then Enter (Set) applied 1 (setting_number takenum 1)
expect notext "LAYOUT FAIL"
expect noquit
