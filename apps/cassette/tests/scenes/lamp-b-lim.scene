title portrait and square recorder, recording, LIM on only
sizes 320x480 480x800 480x480 720x720
ppmm 608
env CASSETTE_DEMO recording
env CASSETTE_DEMO_LIM on
env CASSETTE_DEMO_LOWCUT off
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot lamp-b-lim
expect text "LIM"
expect text "PEAK"
expect notext "LAYOUT FAIL"
expect noquit
