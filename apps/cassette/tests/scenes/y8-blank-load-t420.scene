title Cassette LOAD from the blank cassette, frame 4 of 5 (420 ms): the loaded cassette is falling in, no name yet; same 900 ms swap as between two named cassettes
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO deckempty
env CASSETTE_ANIM_TICKS 42
env CASSETTE_ANIM_FPS 60
env CASSETTE_LOAD_STEP_MS 10
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
key up
wait 200
key l
wait 1300
shot blank-load-t420ms
expect notext "LAYOUT FAIL"
expect noquit
