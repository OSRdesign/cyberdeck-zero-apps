title Cassette LOAD animation, frame 1 of 5 (0 ms): the load has just started: the old cassette (Take 006) is still in its place, the strip and the counter unchanged
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_ANIM_TICKS 1
env CASSETTE_ANIM_FPS 60
env CASSETTE_LOAD_STEP_MS 0
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
key up
wait 200
key l
wait 600
shot load-t000ms
@480x320 expect text "TAKE 006 · 48k/16 WAV · 12 h 40 left"
@320x480 expect text "TAKE 006"
expect notext "LAYOUT FAIL"
expect noquit
