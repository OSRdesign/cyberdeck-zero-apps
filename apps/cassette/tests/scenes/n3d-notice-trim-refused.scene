title Cassette notice on the trim page (T6d): Name refused: use letters, digits, - and _ replaces the top strip; the layout check passes while it shows
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_NOTICE "Name refused: use letters, digits, - and _"
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 300
key t
wait 400
expect text "Name refused: use letters, digits, - and _"
shot trim-refused
expect notext "LAYOUT FAIL"
expect text "SAVE"
expect noquit
