title Cassette Bluetooth (T4, synthetic names): the Output picker: the USB card and Default output (plain rows), a speaker (Music quality, chosen), the headset (Call quality (16 kHz)) and a headset that is not connected (dimmed, Not connected; Enter says why)
sizes 320x480 480x320 480x800 640x480 800x480 480x480 720x720
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_BT output
env CASSETTE_LAYOUT_CHECK 1

wait 500
key s
wait 300
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 300
expect text "XWF-M18 Speaker"
expect text "Music quality"
expect text "Call quality (16 kHz)"
shot output-picker
expect notext "LAYOUT FAIL"
key down
key down
key enter
wait 300
expect text "Not available: Not connected"
shot output-picker-not-connected
expect notext "LAYOUT FAIL"
key esc
wait 300
key esc
wait 300
expect text "SOFT"
expect noquit
