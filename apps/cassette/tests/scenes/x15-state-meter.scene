title Cassette state (PLAY/PAUSE key, hubs, meter): a take playing with the played level at -12 dBFS (10 steps on L and R, in the TARGET zone, PEAK off)
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO playing-meter
env CASSETTE_ANIM_TICKS 2
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot state-meter
expect text "PLAY"
expect notext "PAUSE"
expect notext "LAYOUT FAIL"
expect noquit
