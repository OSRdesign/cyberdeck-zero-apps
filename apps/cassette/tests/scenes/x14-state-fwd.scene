title Cassette state (PLAY/PAUSE key, hubs, meter): FWD held (5x forwards): FWD and PLAY latched, both hubs counterclockwise at 3x (another angle than playing)
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO fwd
env CASSETTE_ANIM_TICKS 2
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot state-fwd
expect text "PLAY"
expect notext "PAUSE"
expect notext "LAYOUT FAIL"
expect noquit
