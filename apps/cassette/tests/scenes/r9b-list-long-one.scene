title Cassette: the recordings list with one long name among normal rows, the long row selected
sizes 320x480 480x320 640x480 480x800 480x480 720x720
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_LIST_LONG 2
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
expect text "Take 007"
expect text "Interview with the mayor 005"
shot r9b-list-long-one
expect notext "LAYOUT FAIL"
key esc
wait 300
expect noquit
