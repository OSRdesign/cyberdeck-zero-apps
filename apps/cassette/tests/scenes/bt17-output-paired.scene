title Cassette Bluetooth (T8, synthetic names): the Output picker with a connected speaker (Music quality, chosen), the headset (Call quality (16 kHz)) and two paired devices the launcher says are not connected (a headset and a speaker, dimmed, "Not connected: connect it in Settings > Bluetooth"; Enter says why)
sizes 320x480 480x320 480x800 640x480 800x480 480x480 720x720
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_BT output-paired
env CASSETTE_LAYOUT_CHECK 1

wait 500
key s
wait 300
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
wait 300
expect text "XWF-M18 Speaker"
expect text "Music quality"
expect text "Beats Fit Pro"
expect text "Not connected: connect it in Settings > Bluetooth"
shot output-paired
expect notext "LAYOUT FAIL"
key down
key down
key enter
wait 300
expect text "Not available: Not connected: connect it in Settings > Bluetooth"
shot output-paired-refused
expect notext "LAYOUT FAIL"
key down
key enter
wait 300
expect text "Bluetooth device 5D:1A"
expect text "Not available: Not connected: connect it in Settings > Bluetooth"
shot output-paired-refused-2
expect notext "LAYOUT FAIL"
key esc
wait 300
key esc
wait 300
expect text "SOFT"
expect noquit
