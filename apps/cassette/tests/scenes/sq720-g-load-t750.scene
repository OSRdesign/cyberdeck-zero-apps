title square screen, LOAD animation frame at 750 ms
sizes 720x720
ppmm 800
env CASSETTE_DEMO idle
env CASSETTE_ANIM_TICKS 75
env CASSETTE_ANIM_FPS 60
env CASSETTE_LOAD_STEP_MS 10
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
key up
wait 200
key l
wait 1850
shot load-t750ms
expect text "Take 007"
expect notext "LAYOUT FAIL"
expect noquit
