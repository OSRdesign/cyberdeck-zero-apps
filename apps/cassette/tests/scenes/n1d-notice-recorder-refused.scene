title Cassette notice on the recorder page (T6d): Name refused: use letters, digits, - and _ replaces the info strip (landscape) or the counter row (narrow, a tap dismisses it); the layout check passes while it shows
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_NOTICE "Name refused: use letters, digits, - and _"
env CASSETTE_LAYOUT_CHECK 1

wait 500
expect text "Name refused: use letters, digits, - and _"
shot recorder-refused
expect notext "LAYOUT FAIL"
expect text "SOFT"
@320x480 tap "Name refused: use letters, digits, - and _"
@320x480 wait 300
@320x480 expect notext "Name refused: use letters, digits, - and _"
@320x480 say a tap on the notice dismissed it
@320x480 expect text "CARD"
expect noquit
