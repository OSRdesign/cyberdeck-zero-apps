title Cassette LOAD animation, frame 2 of 5 (70 ms): the old cassette (Take 006) is dropping out through the bottom of the window (ease in)
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_ANIM_TICKS 7
env CASSETTE_ANIM_FPS 60
env CASSETTE_LOAD_STEP_MS 10
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
key up
wait 200
key l
wait 650
shot load-t070ms
@480x320 expect text "TAKE 006 · 48k/16 WAV · 12 h 40 left"
expect notext "LAYOUT FAIL"
expect noquit
