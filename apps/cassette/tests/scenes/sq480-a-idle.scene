title square screen, recorder idle with Take 006 loaded
sizes 480x480
ppmm 667
env CASSETTE_DEMO idle
env CASSETTE_LAYOUT_CHECK 1

wait 600
shot idle
expect esc
expect text "CARD"
expect text "SOFT"
expect text "TAKE 006"
expect text "48k/16 WAV · 12 h 40 left"
expect notext "OPEN"
expect notext "LAYOUT FAIL"
expect noquit
