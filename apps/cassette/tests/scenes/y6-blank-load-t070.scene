title Cassette LOAD from the blank cassette, frame 2 of 5 (70 ms): the blank cassette is dropping out through the bottom, half way, still blank; same 900 ms swap as between two named cassettes
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO deckempty
env CASSETTE_ANIM_TICKS 7
env CASSETTE_ANIM_FPS 60
env CASSETTE_LOAD_STEP_MS 10
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
key up
wait 200
key l
wait 600
shot blank-load-t070ms
expect notext "Take 007"
expect notext "LAYOUT FAIL"
expect noquit
