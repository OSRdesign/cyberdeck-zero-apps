title Cassette notice on the trim page (T6d): Save failed: not enough space on the card replaces the top strip; the layout check passes while it shows
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO idle
env CASSETTE_DEMO_NOTICE "Save failed: not enough space on the card"
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 300
key t
wait 400
expect text "Save failed: not enough space on the card"
shot trim-savefail
expect notext "LAYOUT FAIL"
expect text "SAVE"
expect noquit
