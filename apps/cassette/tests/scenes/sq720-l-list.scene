title square screen, the recordings list
sizes 720x720
ppmm 800
env CASSETTE_DEMO idle
env CASSETTE_LAYOUT_CHECK 1

wait 500
key l
wait 400
expect text "Take 007"
expect text "Take 006"
expect text "RENAME"
expect text "TRIM"
expect text "DELETE"
shot list
expect notext "LAYOUT FAIL"
key esc
wait 300
expect text "SOFT"
expect noquit
