title Cassette bound (stereo 44.1 kHz card): Opus rows dimmed with the model's reason; Enter on one shows 'Not available: ...' and stays; FLAC can be chosen
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO 1
env CASSETTE_DEMO_HOME demo-home
env CASSETTE_DEMO_CARD stereo
env CASSETTE_DEMO_CODECS both
env CASSETTE_LAYOUT_CHECK 1

wait 1500
key s
wait 500
tap "Format"
wait 500
expect text "Opus cannot record at 44.1 kHz"
expect text "Sizes at 44.1 kHz stereo 16-bit, this card"
shot picker-top
expect notext "LAYOUT FAIL"
key down
key down
key down
key enter
wait 300
expect text "Not available: Opus cannot record at 44.1 kHz"
shot picker-notice
expect notext "LAYOUT FAIL"
key up
key up
key enter
wait 500
expect text "FLAC"
say Enter on FLAC chose it (setting_choice format 1) and the page went back
shot settings-flac
expect notext "LAYOUT FAIL"
expect noquit
