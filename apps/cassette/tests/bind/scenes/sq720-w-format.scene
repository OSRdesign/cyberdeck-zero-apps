title square screen: Cassette: the Format picker (stereo 44.1 kHz card, Opus rows dimmed, a tap on one shows the notice)
sizes 720x720
ppmm 800
env CASSETTE_DEMO 1
env CASSETTE_DEMO_HOME demo-home
env CASSETTE_DEMO_CARD stereo
env CASSETTE_DEMO_CODECS both
env CASSETTE_LAYOUT_CHECK 1

wait 1500
key s
wait 500
tap "Format"
wait 500
shot picker
expect notext "LAYOUT FAIL"
key down
key down
key down
key enter
wait 300
expect text "Not available: Opus cannot record at 44.1 kHz"
shot picker-notice
expect notext "LAYOUT FAIL"
expect noquit
