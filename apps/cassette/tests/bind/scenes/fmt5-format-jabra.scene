title Cassette bound (16 kHz speech headset): sizes at 16 kHz mono; Opus 24 kbps chosen, the Settings row shows it
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO 1
env CASSETTE_DEMO_HOME demo-home
env CASSETTE_DEMO_CARD speech
env CASSETTE_DEMO_CODECS both
env CASSETTE_LAYOUT_CHECK 1

wait 1500
key s
wait 500
tap "Format"
wait 500
expect text "Sizes at 16 kHz mono 16-bit, this card"
shot picker-top
expect notext "LAYOUT FAIL"
key down
key down
key enter
wait 500
expect text "Opus 24 kbps"
shot settings-opus
tap "Format"
wait 500
shot picker-current-opus
expect notext "LAYOUT FAIL"
expect noquit
