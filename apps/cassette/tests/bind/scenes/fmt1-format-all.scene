title Cassette bound (mono 48 kHz card, both libraries): Settings > Format lists all six formats with sizes per minute at the card's format, hours free and the footer; Esc keeps the choice
sizes 480x320 320x480 640x480
ppmm 608
env CASSETTE_DEMO 1
env CASSETTE_DEMO_HOME demo-home
env CASSETTE_DEMO_CARD level
env CASSETTE_DEMO_CODECS both
env CASSETTE_LAYOUT_CHECK 1

wait 1500
key s
wait 500
expect text "Format"
expect text "WAV 48 kHz 16-bit"
shot settings
tap "Format"
wait 500
expect text "Opus 32 kbps"
expect text "5.8 MB/min"
expect text "Sizes at 48 kHz mono 16-bit, this card"
shot picker-top
expect notext "LAYOUT FAIL"
key down
key down
key down
key down
key down
key down
wait 300
shot picker-bottom
expect text "Opus 128 kbps"
expect notext "LAYOUT FAIL"
key esc
wait 300
expect text "WAV 48 kHz 16-bit"
say Esc closed the picker without a change (no setting_choice)
expect notext "LAYOUT FAIL"
expect noquit
